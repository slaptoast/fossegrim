# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Required: long random secret used to sign JWTs. Generate with e.g.
# openssl rand -base64 48
JWT_KEY=

# Host path to your music library, mounted read-only into the container
# at /music.
MUSIC_LIBRARY_PATH=./music

# Host port to publish.
PORT=8080

# Optional: Last.fm API application credentials (create one at
# https://www.last.fm/api/account/create). Leave empty to disable Last.fm.
LASTFM_API_KEY=
LASTFM_API_SECRET=
