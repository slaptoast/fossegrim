# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Optional: secret used to sign JWTs. Leave empty to have one generated
# into the data volume (/data/jwt.key) on first run. To set your own,
# generate with e.g. openssl rand -base64 48
JWT_KEY=

# Host path to your music library, mounted read-only into the container
# at /music.
MUSIC_LIBRARY_PATH=./music

# Host folder that backups are written to, mounted at /backups. Must be
# writable by the container's user (uid 100, gid 101).
BACKUP_PATH=./backups

# Host ports the proxy listens on. Plain HTTP always works on HTTP_PORT;
# HTTPS_PORT starts answering once there's a certificate (Settings ->
# HTTPS). Let's Encrypt only checks domains on port 80, so keep HTTP_PORT
# at 80 (or forward port 80 on your router to it) if you want a
# certificate from it.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: Last.fm API application credentials (create one at
# https://www.last.fm/api/account/create). Usually left empty and entered by
# an admin on the Settings page instead; when set, these override it.
LASTFM_API_KEY=
LASTFM_API_SECRET=
