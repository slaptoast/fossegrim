@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceService Appearance
@inject FossegrimApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-shell @(PlayerOnTop ? "player-top" : null)">
    <header class="topbar">
        <span class="topbar-title"><span aria-hidden="true">🎵</span><span class="topbar-title-text"> Fossegrim</span></span>
        <nav class="topbar-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Library</NavLink>
            <NavLink href="/playlists">Playlists</NavLink>
            <NavLink href="/listens">Listens</NavLink>
        </nav>
        <TopBarSearch />
        <ScanIndicator />
        <LibraryStats />
        <UserMenu />
    </header>

    @if (PlayerOnTop)
    {
        <PlayerBar />
    }

    <main class="app-content">
        <SafeModeBanner />
        @Body
        <AppFooter />
    </main>

    @if (!PlayerOnTop)
    {
        <PlayerBar />
    }
    <Toasts />
    @* Outside the bar, so playback carries on whichever way the player is shown. *@
    <PlayerEngine />
</div>

@code {
    private bool PlayerOnTop => Appearance.Current.Player.Position == "top";

    protected override async Task OnInitializedAsync()
    {
        Appearance.Changed += OnAppearanceChanged;
        await ResumeSetupAsync();
        await Appearance.EnsureLoadedAsync();
    }

    // An admin who created the first account but left the wizard before
    // finishing it is sent back to it until they do (every step can be skipped).
    private async Task ResumeSetupAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (!user.IsInRole("Admin"))
        {
            return;
        }

        try
        {
            if (!(await ApiClient.GetSetupStatusAsync()).SetupComplete)
            {
                Navigation.NavigateTo("/setup", replace: true);
            }
        }
        catch
        {
            // Never block the app on this.
        }
    }

    private void OnAppearanceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
    }
}
