@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceService Appearance

<div class="app-shell @(PlayerOnTop ? "player-top" : null)">
    <header class="topbar">
        <span class="topbar-title">🎵 Fossegrim</span>
        <nav class="topbar-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Library</NavLink>
            <NavLink href="/playlists">Playlists</NavLink>
            <NavLink href="/listens">Listens</NavLink>
        </nav>
        <LibraryStats />
        <UserMenu />
    </header>

    @if (PlayerOnTop)
    {
        <PlayerBar />
    }

    <main class="app-content">
        @Body
        <AppFooter />
    </main>

    @if (!PlayerOnTop)
    {
        <PlayerBar />
    }
    <Toasts />
</div>

@code {
    private bool PlayerOnTop => Appearance.Current.Player.Position == "top";

    protected override async Task OnInitializedAsync()
    {
        Appearance.Changed += OnAppearanceChanged;
        await Appearance.EnsureLoadedAsync();
    }

    private void OnAppearanceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
    }
}
