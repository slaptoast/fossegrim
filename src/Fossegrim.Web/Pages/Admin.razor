@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject ScanStatusService Scans

<div class="container">
    <div class="header">
        <h1>⚙️ Admin Panel</h1>
        <p>Manage your media library</p>
    </div>

    <div class="content">
        <h2 class="section-header">Library Scan</h2>
        <p>
            A quick scan reads only new and changed files, and removes tracks whose files are gone.
            A full rescan re-reads every file. Scans run in the background, one at a time.
            Folders are managed in <a href="/settings">Settings</a>.
        </p>

        @if (_errorMessage is not null)
        {
            <div class="error-message">@_errorMessage</div>
        }

        <div class="scan-actions">
            <button type="button" class="button" disabled="@_starting" @onclick="() => ScanAsync(full: false)">Quick Scan</button>
            <button type="button" class="button-secondary" disabled="@_starting" @onclick="() => ScanAsync(full: true)">Full Rescan</button>
        </div>
        <ScanProgress />

        <h2 class="section-header">Library Health</h2>
        <p>Find files whose ID3v1 and ID3v2 tags disagree, or whose names don't match the file-naming template, and fix them.</p>
        <a class="button-secondary" href="/library-health">Open Library Health</a>

        <h2 class="section-header">Updates</h2>
        <UpdateCheckSettings />

        <h2 class="section-header">Setup Wizard</h2>
        <p>Walk through every server setting again: media folders, Last.fm, accounts, backups and updates. Each step can be skipped.</p>
        <a class="button-secondary" href="/setup">Run Setup Wizard</a>
    </div>
</div>

@code {
    private bool _starting;
    private string? _errorMessage;

    private async Task ScanAsync(bool full)
    {
        _starting = true;
        _errorMessage = null;
        try
        {
            await Scans.StartAsync(new StartScanRequest(Full: full));
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }
}
