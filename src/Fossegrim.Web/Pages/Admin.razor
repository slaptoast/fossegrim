@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject FossegrimApiClient ApiClient

<div class="container">
    <div class="header">
        <h1>⚙️ Admin Panel</h1>
        <p>Manage your media library</p>
    </div>

    <div class="content">
        <EditForm Model="_input" OnValidSubmit="ScanAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="folderPath">Media Folder Path</label>
                <InputText id="folderPath" @bind-Value="_input.FolderPath" placeholder="/Users/username/Music" />
            </div>

            <div class="form-group">
                <label for="maxThreads">Max Parallel Threads</label>
                <InputNumber id="maxThreads" @bind-Value="_input.MaxDegreeOfParallelism" />
            </div>

            <button type="submit" class="button" disabled="@_isScanning">@(_isScanning ? "Scanning..." : "Scan Media Library")</button>
        </EditForm>

        @if (_isScanning)
        {
            <div class="scanning"><h2>Scanning media library</h2></div>
        }

        @if (_errorMessage is not null)
        {
            <div class="error"><strong>Error</strong>@_errorMessage</div>
        }

        @if (_lastScanResult is not null)
        {
            <div class="result-card">
                <div class="success-icon">✅</div>
                <h2>Scan Complete!</h2>

                <div class="stats-grid">
                    <div class="stat">
                        <div class="stat-value">@_lastScanResult.ScannedCount</div>
                        <div class="stat-label">Files Scanned</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">@_lastScanResult.ItemsAdded</div>
                        <div class="stat-label">Items Added</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">@_lastScanResult.ItemsUpdated</div>
                        <div class="stat-label">Items Updated</div>
                    </div>
                </div>

                <p class="result-meta">
                    <strong>Folder:</strong> @_lastScanResult.FolderPath
                </p>
            </div>
        }

        <h2 class="section-header">Updates</h2>

        @if (_updateMessage is not null)
        {
            <div class="error-message">@_updateMessage</div>
        }

        @if (_updates is not null)
        {
            <div class="folder-item update-status">
                <p><strong>Running:</strong> @DisplayVersion(_updates.CurrentVersion)</p>

                @if (!_updates.CanCheck)
                {
                    <p>This is a development build, so there's no release version to compare against Docker Hub.</p>
                }
                else
                {
                    <p>
                        <strong>Latest release:</strong>
                        @(_updates.LatestVersion is null ? "not checked yet" : DisplayVersion(_updates.LatestVersion))
                        @if (_updates.CheckedAt is { } checkedAt)
                        {
                            <span class="update-checked-at">&nbsp;(checked @checkedAt.ToLocalTime().ToString("g"))</span>
                        }
                    </p>

                    @if (_updates.UpdateAvailable)
                    {
                        <div class="info-text">
                            Version @_updates.LatestVersion is available.
                            Pull the new image and recreate the container (<code>docker compose pull &amp;&amp; docker compose up -d</code>).
                            <a href="@_updates.ReleaseUrl" target="_blank" rel="noopener">View on Docker Hub</a>
                        </div>
                    }
                    else if (_updates.LatestVersion is not null && _updates.Error is null)
                    {
                        <div class="success-message">You're up to date.</div>
                    }

                    @if (_updates.Error is not null)
                    {
                        <div class="error-message">@_updates.Error</div>
                    }

                    <label class="checkbox-row">
                        <input type="checkbox" checked="@_updates.Enabled" disabled="@_updateBusy" @onchange="SetUpdateCheckEnabledAsync" />
                        Check for updates automatically (once a day)
                    </label>

                    <button type="button" class="button-secondary" disabled="@_updateBusy" @onclick="CheckForUpdatesAsync">
                        @(_updateBusy ? "Checking..." : "Check Now")
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly ScanInput _input = new();
    private bool _isScanning;
    private ScanResult? _lastScanResult;
    private string? _errorMessage;

    private UpdateStatusDto? _updates;
    private string? _updateMessage;
    private bool _updateBusy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _updates = await ApiClient.GetUpdateStatusAsync();
        }
        catch (Exception ex)
        {
            _updateMessage = $"Failed to load update status: {ex.Message}";
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _updateBusy = true;
        _updateMessage = null;
        try
        {
            _updates = await ApiClient.CheckForUpdatesAsync();
        }
        catch (Exception ex)
        {
            _updateMessage = ex.Message;
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task SetUpdateCheckEnabledAsync(ChangeEventArgs e)
    {
        _updateBusy = true;
        _updateMessage = null;
        try
        {
            _updates = await ApiClient.SetUpdateCheckEnabledAsync(e.Value is true);
        }
        catch (Exception ex)
        {
            _updateMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _updateBusy = false;
        }
    }

    // Matches the footer: "v1.2.3" for releases, anything else as-is.
    private static string DisplayVersion(string version) => char.IsDigit(version[0]) ? $"v{version}" : version;

    private async Task ScanAsync()
    {
        _isScanning = true;
        _errorMessage = null;
        try
        {
            _lastScanResult = await ApiClient.ScanAsync(_input.FolderPath, _input.MaxDegreeOfParallelism);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Scan failed: {ex.Message}";
        }
        finally
        {
            _isScanning = false;
        }
    }

    private class ScanInput
    {
        [Required]
        public string FolderPath { get; set; } = "/Users/tj/Documents/Music";

        [Range(1, 16)]
        public int MaxDegreeOfParallelism { get; set; } = 4;
    }
}
