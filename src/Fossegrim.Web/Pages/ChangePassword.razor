@page "/change-password"
@attribute [Authorize]
@inject FossegrimApiClient ApiClient

<div class="container narrow">
    <div class="header small">
        <h1>🔑 Change Password</h1>
        <p>Update your account password</p>
    </div>

    <div class="content">
        @if (_statusMessage is not null)
        {
            <div class="success-message">@_statusMessage</div>
        }

        @if (_errors.Count > 0)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="_input" OnValidSubmit="ChangePasswordAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="oldPassword">Current Password</label>
                <InputText id="oldPassword" @bind-Value="_input.OldPassword" type="password" autocomplete="current-password" />
                <ValidationMessage For="() => _input.OldPassword" />
            </div>

            <div class="form-group">
                <label for="newPassword">New Password</label>
                <InputText id="newPassword" @bind-Value="_input.NewPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _input.NewPassword" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <InputText id="confirmPassword" @bind-Value="_input.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _input.ConfirmPassword" />
            </div>

            <button type="submit" class="button">Change Password</button>
        </EditForm>
    </div>
</div>

@code {
    private readonly ChangePasswordInput _input = new();
    private string? _statusMessage;
    private List<string> _errors = [];

    private async Task ChangePasswordAsync()
    {
        _errors = [];
        var errors = await ApiClient.ChangePasswordAsync(_input.OldPassword, _input.NewPassword);
        if (errors.Count > 0)
        {
            _errors = errors.ToList();
            return;
        }

        _statusMessage = "Your password has been changed.";
        _input.OldPassword = "";
        _input.NewPassword = "";
        _input.ConfirmPassword = "";
    }

    private class ChangePasswordInput
    {
        [Required]
        public string OldPassword { get; set; } = string.Empty;

        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
