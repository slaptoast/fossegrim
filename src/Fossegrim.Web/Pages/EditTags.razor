@page "/tags/edit"
@attribute [Authorize(Roles = "Admin")]
@inject FossegrimApiClient ApiClient
@inject NavigationManager Navigation

<div class="container wide">
    <div class="header">
        <h1>🏷️ Edit Tags</h1>
        <p>Editing @_models.Count track@(_models.Count == 1 ? "" : "s")</p>
    </div>

    <div class="content">
        @if (_isLoading)
        {
            <div class="loading"><h2>Loading tracks</h2></div>
        }
        else if (_errorMessage is not null)
        {
            <div class="error">@_errorMessage</div>
        }
        else
        {
            @if (_saveErrors.Count > 0)
            {
                <div class="error">
                    <strong>Some tracks failed to save:</strong>
                    <ul>
                        @foreach (var err in _saveErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="tag-edit-table-wrapper">
                <table class="tag-edit-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Album</th>
                            <th>Track #</th>
                            <th>Year</th>
                            <th>Genre</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_models.Count > 1)
                        {
                            @* Filled-in values here are copied to every track; blanks leave tracks as they are. *@
                            <tr class="tag-edit-apply-row">
                                <td>
                                    <button type="button" class="button-secondary" disabled="@(!_applyAll.HasAnyValue)" @onclick="ApplyToAll"
                                            title="Copy the values in this row to every track below">Apply to all</button>
                                </td>
                                <td><input type="text" @bind="_applyAll.ArtistName" @bind:event="oninput" placeholder="Artist for all" /></td>
                                <td><input type="text" @bind="_applyAll.Album" @bind:event="oninput" placeholder="Album for all" /></td>
                                <td></td>
                                <td><input type="number" @bind="_applyAll.Year" @bind:event="oninput" placeholder="Year" /></td>
                                <td><input type="text" @bind="_applyAll.Genre" @bind:event="oninput" placeholder="Genre for all" /></td>
                            </tr>
                        }
                        @foreach (var model in _models)
                        {
                            <tr>
                                <MediaItemTagFields Model="model" Compact="true" />
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tag-edit-actions">
                <button type="button" class="button-secondary" disabled="@_isSaving" @onclick="Cancel">Cancel</button>
                <button type="button" class="button" disabled="@_isSaving" @onclick="SaveAllAsync">@(_isSaving ? "Saving..." : $"Save All ({_models.Count})")</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private List<MediaItemTagEditModel> _models = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private List<string> _saveErrors = [];
    private readonly ApplyToAllInput _applyAll = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var requestedIds = (Ids ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => Guid.TryParse(s, out var id) ? id : (Guid?)null)
                .Where(id => id.HasValue)
                .Select(id => id!.Value)
                .ToList();

            if (requestedIds.Count == 0)
            {
                _errorMessage = "No tracks were specified to edit.";
                return;
            }

            var allItems = await ApiClient.GetMediaItemsAsync();
            var byId = allItems.ToDictionary(m => m.Id);

            _models = requestedIds
                .Where(id => byId.ContainsKey(id))
                .Select(id => MediaItemTagEditModel.FromMediaItem(byId[id]))
                .ToList();

            if (_models.Count == 0)
            {
                _errorMessage = "None of the requested tracks could be found.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading tracks: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    // Copies the Apply-to-all row's filled-in fields onto every track. Nothing
    // is saved until Save All, so the result can still be reviewed per row.
    private void ApplyToAll()
    {
        foreach (var model in _models)
        {
            if (!string.IsNullOrWhiteSpace(_applyAll.ArtistName))
            {
                model.ArtistName = _applyAll.ArtistName.Trim();
            }
            if (!string.IsNullOrWhiteSpace(_applyAll.Album))
            {
                model.Album = _applyAll.Album.Trim();
            }
            if (_applyAll.Year is > 0)
            {
                model.Year = _applyAll.Year;
            }
            if (!string.IsNullOrWhiteSpace(_applyAll.Genre))
            {
                model.Genre = _applyAll.Genre.Trim();
            }
        }

        _applyAll.Clear();
    }

    private class ApplyToAllInput
    {
        public string? ArtistName { get; set; }
        public string? Album { get; set; }
        public int? Year { get; set; }
        public string? Genre { get; set; }

        public bool HasAnyValue =>
            !string.IsNullOrWhiteSpace(ArtistName) || !string.IsNullOrWhiteSpace(Album) ||
            Year is > 0 || !string.IsNullOrWhiteSpace(Genre);

        public void Clear()
        {
            ArtistName = null;
            Album = null;
            Year = null;
            Genre = null;
        }
    }

    private async Task SaveAllAsync()
    {
        _isSaving = true;
        _saveErrors = [];
        try
        {
            var result = await ApiClient.UpdateMediaItemTagsAsync(_models.Select(m => m.ToUpdateRequest()));
            var errors = result.Errors.ToList();
            if (errors.Count > 0)
            {
                // Errors only carry an id, so name the track they belong to.
                var titles = _models.ToDictionary(m => m.Id, m => m.Title);
                _saveErrors = errors
                    .Select(e => $"{(titles.TryGetValue(e.Id, out var t) && !string.IsNullOrWhiteSpace(t) ? t : e.Id.ToString())}: {e.Error}")
                    .ToList();
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            _saveErrors = [$"Failed to save: {ex.Message}"];
        }
        finally
        {
            _isSaving = false;
        }
    }
}
