@page "/forgot-password"
@layout LoginLayout
@inject FossegrimApiClient ApiClient

<div class="container narrow">
    <div class="header">
        <h1>🔑 Forgot Password</h1>
        <p>Get a link to choose a new one</p>
    </div>

    <div class="content">
        @if (_options is null)
        {
            <p>Loading...</p>
        }
        else if (_sent)
        {
            <div class="success-message">
                If an account uses @_input.Email, a reset link is on its way. It works once, for 24 hours.
            </div>
            <p>Nothing arrived? Check your spam folder, or ask an admin for a reset link.</p>
        }
        else if (_options.ByEmail)
        {
            @if (_errors.Count > 0)
            {
                <div class="validation-summary">
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <p>Enter your account's email address and we'll send you a link to reset your password.</p>

            <EditForm Model="_input" OnValidSubmit="SendAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="_input.Email" type="email" autocomplete="username" />
                    <ValidationMessage For="() => _input.Email" />
                </div>

                <button type="submit" class="button" disabled="@_busy">@(_busy ? "Sending..." : "Send reset link")</button>
            </EditForm>
        }
        else
        {
            <p>This server isn't set up to send email. Ask an admin to make you a reset link: they'll find it under Settings → Accounts.</p>
            <p class="backup-hint">
                If you're the only admin, run this on the server to get a link:<br />
                <code>docker compose exec fossegrim fossegrim reset-password you@example.com</code>
            </p>
        }
    </div>

    <div class="content">
        <div class="nav-links centered">
            <a href="/login">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    private PasswordResetOptionsDto? _options;
    private readonly ForgotInput _input = new();
    private List<string> _errors = [];
    private bool _busy;
    private bool _sent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _options = await ApiClient.GetPasswordResetOptionsAsync();
        }
        catch
        {
            _options = new PasswordResetOptionsDto(false);
        }
    }

    private async Task SendAsync()
    {
        _busy = true;
        _errors = [];
        try
        {
            _errors = (await ApiClient.ForgotPasswordAsync(_input.Email)).ToList();
            _sent = _errors.Count == 0;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private class ForgotInput
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
