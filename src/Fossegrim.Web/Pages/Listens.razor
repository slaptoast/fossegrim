@page "/listens"
@attribute [Authorize]
@implements IDisposable
@inject FossegrimApiClient ApiClient
@inject PlayerState PlayerState

<div class="track-list-component">
    <div class="controls">
        <div class="search-box">
            <input type="text" placeholder="🔍 Search by title, artist, album, genre, year, or label..." @oninput="OnSearchChanged" />
        </div>
        @if (_history is not null)
        {
            <span class="listens-count">@_history.TotalCount @(_history.TotalCount == 1 ? "listen" : "listens")</span>
        }
    </div>

    <div class="content">
        @if (_errorMessage is not null)
        {
            <div class="error"><h3>Error</h3><p>@_errorMessage</p></div>
        }
        else if (_history is null)
        {
            <div class="loading"><h2>Loading listens</h2></div>
        }
        else if (_history.Items.Count == 0)
        {
            <div class="no-results">
                <h2>No listens found</h2>
                <p>@(string.IsNullOrWhiteSpace(_search)
                    ? "Tracks show up here once you've listened to 90% of them."
                    : "No listens match your search.")</p>
            </div>
        }
        else
        {
            <table class="listens-table">
                <thead>
                    <tr>
                        <th class="played-cell">Played</th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Album</th>
                        <th>Genre</th>
                        <th class="year-cell">Year</th>
                        <th class="listened-cell">Listened</th>
                        @if (_showScrobbleColumn)
                        {
                            <th class="scrobble-cell">Last.fm</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var play in _history.Items)
                    {
                        <tr @onclick="() => PlayAsync(play.MediaItem)" title="Play this track">
                            <td class="played-cell">@FormatPlayedAt(play.PlayedAt)</td>
                            <td class="title-cell">@(play.MediaItem.Title ?? "Unknown")</td>
                            <td class="artist-cell">@(play.MediaItem.ArtistName ?? "Unknown Artist")</td>
                            <td class="album-cell">@play.MediaItem.Album</td>
                            <td>@play.MediaItem.Genre</td>
                            <td class="year-cell">@play.MediaItem.Year</td>
                            <td class="listened-cell">@FormatDuration(play.ListenedFor)</td>
                            @if (_showScrobbleColumn)
                            {
                                <td class="scrobble-cell scrobble-@(play.ScrobbleStatus?.ToLowerInvariant())" title="@ScrobbleTooltip(play)">@ScrobbleIcon(play.ScrobbleStatus)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <Pager CurrentPage="_page" CurrentPageChanged="GoToPageAsync" TotalPages="TotalPages" />
</div>

@code {
    private const int PageSize = 50;
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(300);

    private PlayHistoryPageDto? _history;
    private string _search = "";
    private int _page = 1;
    private string? _errorMessage;
    private CancellationTokenSource? _searchDelay;
    // Responses can arrive out of order while typing; only the latest one is shown.
    private int _requestVersion;

    // Only shown once some listen on the page is going to Last.fm.
    private bool _showScrobbleColumn => _history?.Items.Any(p => p.ScrobbleStatus is not null) ?? false;

    private int TotalPages => _history is null ? 1 : Math.Max(1, (int)Math.Ceiling(_history.TotalCount / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var version = ++_requestVersion;
        try
        {
            var history = await ApiClient.GetPlayHistoryAsync(_search, _page, PageSize);
            if (version == _requestVersion)
            {
                _history = history;
                _errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            if (version == _requestVersion)
            {
                _errorMessage = $"Error loading listens: {ex.Message}";
            }
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDelay, _searchDelay.Token);
        }
        catch (TaskCanceledException)
        {
            return; // superseded by a later keystroke
        }

        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private Task PlayAsync(PlayedTrackDto track) => PlayerState.PlayAsync(new MediaItemDto(
        track.Id, track.Title, track.ArtistName, track.Album, null, null,
        track.Year, track.Track, track.Genre, track.Duration, null, [], []));

    private static string FormatPlayedAt(DateTime playedAtUtc)
    {
        var local = DateTime.SpecifyKind(playedAtUtc, DateTimeKind.Utc).ToLocalTime();
        return local.Year == DateTime.Now.Year
            ? local.ToString("MMM d, h:mm tt")
            : local.ToString("MMM d yyyy, h:mm tt");
    }

    private static string ScrobbleIcon(string? status) => status switch
    {
        "Scrobbled" => "✓",
        "Pending" => "…",
        "Ignored" or "Failed" => "✕",
        _ => ""
    };

    private static string? ScrobbleTooltip(PlayEventDto play) => play.ScrobbleStatus switch
    {
        null => null,
        "Scrobbled" => "Scrobbled to Last.fm",
        "Pending" => play.ScrobbleError is null ? "Sending to Last.fm" : $"Will retry: {play.ScrobbleError}",
        _ => $"{play.ScrobbleStatus}: {play.ScrobbleError}"
    };

    private static string FormatDuration(TimeSpan? duration) => duration is { } d
        ? $"{(int)d.TotalMinutes}:{d.Seconds:00}"
        : "";

    public void Dispose()
    {
        _searchDelay?.Cancel();
        _searchDelay?.Dispose();
    }
}
