@page "/login"
@layout LoginLayout
@inject FossegrimApiClient ApiClient
@inject TokenStore TokenStore
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<div class="container narrow">
    <div class="header">
        <h1>🎵 Fossegrim</h1>
        <p>Sign in to your account</p>
    </div>

    <div class="content">
        @if (Reset is not null)
        {
            <div class="success-message">Your password has been changed. Sign in with the new one.</div>
        }

        @if (_errors.Count > 0)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="_input" OnValidSubmit="HandleLoginAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="login">Email or username</label>
                <InputText id="login" @bind-Value="_input.Login" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" />
                <ValidationMessage For="() => _input.Login" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="_input.Password" type="password" autocomplete="current-password" />
                <ValidationMessage For="() => _input.Password" />
            </div>

            <button type="submit" class="button" disabled="@_isSubmitting">@(_isSubmitting ? "Signing in..." : "Sign in")</button>
        </EditForm>

        <div class="nav-links centered">
            <a href="/forgot-password">Forgot password?</a>
        </div>
    </div>

    @* Custom CSS can break this page too; a full reload with ?safe-mode leaves it off. *@
    @if (_hasCustomCss)
    {
        <div class="content">
            <div class="nav-links centered">
                <a href="/login?safe-mode" target="_top">Page looks wrong? Open without custom CSS</a>
            </div>
        </div>
    }

    @if (_registrationOpen)
    {
        <div class="content">
            <div class="nav-links centered">
                <a href="/register">Create account</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    // Set by the reset password page after a new password is saved.
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Reset { get; set; }

    private readonly LoginInput _input = new();
    private List<string> _errors = [];
    private bool _isSubmitting;
    private bool _registrationOpen;
    private bool _hasCustomCss;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await JS.InvokeAsync<bool>("fossegrimTheme.hasCustomCss") && !await JS.InvokeAsync<bool>("fossegrimTheme.isSafeMode"))
        {
            _hasCustomCss = true;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (HostEnvironment.Environment == "Development")
        {
            // dev convenience: prefill the account seeded in Development
            _input.Login = "admin@fossegrim.local";
            _input.Password = "Admin123!";
        }

        try
        {
            var status = await ApiClient.GetSetupStatusAsync();
            if (status.SetupRequired)
            {
                // A fresh install has no accounts to sign in to yet.
                Navigation.NavigateTo("/setup", replace: true);
                return;
            }
            _registrationOpen = status.RegistrationOpen;
        }
        catch
        {
            // Signing in still works without the status; just hide the sign-up link.
        }
    }

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _errors = [];

        var result = await ApiClient.LoginAsync(_input.Login, _input.Password);
        if (result.Success)
        {
            await TokenStore.SetSessionAsync(result.Response!);
            AuthStateProvider.MarkUserAsAuthenticated(result.Response!);
            Navigation.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl);
        }
        else
        {
            _errors = result.Errors.ToList();
        }

        _isSubmitting = false;
    }

    private class LoginInput
    {
        // An email or a display name.
        [Required(ErrorMessage = "Enter your email or username.")]
        public string Login { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
