@page "/"
@attribute [Authorize]
@inject FossegrimApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject AlbumArtEditorState AlbumArtEditor
@inject ScanStatusService Scans
@inject AppearanceService Appearance
@implements IDisposable

<div class="layout-toolbar">
    @if (_editing)
    {
        <span class="layout-toolbar-hint">Drag panels to move them; drag an edge or corner to resize.</span>
        @if (_grid is not null)
        {
            @foreach (var (module, hidden) in _grid.ModuleVisibility.Where(m => m.Hidden))
            {
                <button type="button" class="button-secondary" @onclick="() => _grid.SetHiddenAsync(module.Id, false)">+ @module.Title</button>
            }
            <button type="button" class="button-secondary" @onclick="() => _grid.ResetAsync()">Reset layout</button>
        }
        <button type="button" class="button" @onclick="() => _editing = false">Done</button>
    }
    else
    {
        <button type="button" class="button-secondary layout-edit-button" @onclick="() => _editing = true">Edit layout</button>
    }
</div>

@* Opened from a right-click, the album art editor sits across the top until
   closed, unless it's been added to the layout as a module (then it's there). *@
@if (AlbumArtEditor.Target is not null && _isAdmin && !AlbumArtModuleShown)
{
    <div class="album-art-panel">
        <AlbumArtEditor Temporary="true" />
    </div>
}

<ModuleGrid @ref="_grid" PageId="library" Modules="_modules" Editing="_editing" />

@code {
    private ModuleGrid? _grid;
    private bool _editing;
    private bool _isAdmin;
    private bool _albumArtShown;
    private IReadOnlyList<ModuleGrid.ModuleDefinition> _modules = [];

    private List<MediaItemDto> _mediaItems = [];
    private List<ArtistDto> _artists = [];
    private List<AlbumDto> _albums = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // Set before OnInitializedAsync's first await, which renders the page:
        // OnParametersSet would only run once the library had loaded.
        _modules = BuildModules(includeAlbumArt: false);
        AlbumArtEditor.Changed += OnEditorChanged;
        Appearance.Changed += OnAppearanceChanged;
        Scans.ScanFinished += OnScanFinished;
    }

    // A scan (e.g. a right-click rescan) can add, change or remove anything.
    private void OnScanFinished(ScanJobDto job) => InvokeAsync(async () =>
    {
        try
        {
            _mediaItems = (await ApiClient.GetMediaItemsAsync()).ToList();
            _artists = (await ApiClient.GetArtistsAsync()).OrderBy(a => a.Name).ToList();
            _albums = (await ApiClient.GetAlbumsAsync()).OrderBy(a => a.Name).ToList();
            StateHasChanged();
        }
        catch
        {
            // Best effort; the page still shows what it had.
        }
    });

    // Default layout on the 24-column grid; rows are 40px. Up next and album art start hidden.
    private IReadOnlyList<ModuleGrid.ModuleDefinition> BuildModules(bool includeAlbumArt)
    {
        List<ModuleGrid.ModuleDefinition> modules =
        [
            new("artists", "Artists", new LayoutItem { Id = "artists", X = 0, Y = 0, W = 8, H = 10 }, ArtistsModule),
            new("albums", "Albums", new LayoutItem { Id = "albums", X = 8, Y = 0, W = 8, H = 10 }, AlbumsModule),
            new("visualizer", "Visualizer", new LayoutItem { Id = "visualizer", X = 16, Y = 0, W = 8, H = 10 }, VisualizerPanel, MinW: 6, MinH: 6),
            new("tracks", "Tracks", new LayoutItem { Id = "tracks", X = 0, Y = 10, W = 24, H = 14 }, TracksModule, MinW: 8, MinH: 5),
            new("randomalbums", "Random albums", new LayoutItem { Id = "randomalbums", X = 0, Y = 24, W = 8, H = 8 }, RandomAlbumsModule),
            new("randomtracks", "Random tracks", new LayoutItem { Id = "randomtracks", X = 8, Y = 24, W = 8, H = 8 }, RandomTracksModule),
            new("upnext", "Up next", new LayoutItem { Id = "upnext", X = 16, Y = 24, W = 8, H = 10, Hidden = true }, UpNextModule),
        ];
        if (includeAlbumArt)
        {
            modules.Add(new("albumart", "Album art", new LayoutItem { Id = "albumart", X = 0, Y = 34, W = 24, H = 12, Hidden = true }, AlbumArtModule, MinW: 10, MinH: 8));
        }
        return modules;
    }

    private bool AlbumArtModuleShown => _grid?.ModuleVisibility.Any(m => m.Module.Id == "albumart" && !m.Hidden) ?? false;

    private void OnEditorChanged() => InvokeAsync(StateHasChanged);

    // Hiding the album art module while it's editing closes the editor,
    // rather than moving it to the top of the page.
    private void OnAppearanceChanged() => InvokeAsync(() =>
    {
        var shown = AlbumArtModuleShown;
        if (_albumArtShown && !shown)
        {
            AlbumArtEditor.Close();
        }
        _albumArtShown = shown;
        StateHasChanged();
    });

    protected override void OnAfterRender(bool firstRender)
    {
        _albumArtShown = AlbumArtModuleShown;
    }

    public void Dispose()
    {
        AlbumArtEditor.Changed -= OnEditorChanged;
        Appearance.Changed -= OnAppearanceChanged;
        Scans.ScanFinished -= OnScanFinished;
        AlbumArtEditor.IsAvailable = false;
        AlbumArtEditor.Close();
    }

    private RenderFragment ArtistsModule => @<ArtistList Artists="_artists" />;

    private RenderFragment AlbumsModule => @<AlbumList Albums="_albums" AllMediaItems="_mediaItems" />;

    private RenderFragment RandomAlbumsModule => @<RandomAlbums AllMediaItems="_mediaItems" />;

    private RenderFragment RandomTracksModule => @<RandomTracks />;

    private RenderFragment VisualizerPanel => @<VisualizerModule />;

    private RenderFragment AlbumArtModule => @<AlbumArtEditor />;

    private RenderFragment TracksModule => @<text>
        @if (_isLoading)
        {
            <div class="track-list-component"><div class="loading"><h2>Loading media library</h2></div></div>
        }
        else if (_errorMessage is not null)
        {
            <div class="track-list-component"><div class="error"><h3>Error</h3><p>@_errorMessage</p></div></div>
        }
        else
        {
            <TrackList MediaItems="_mediaItems" OnItemUpdated="HandleItemUpdated" />
        }
    </text>;

    private RenderFragment UpNextModule => @<div class="track-list-component up-next-module">
        <div class="up-next-module-header"><h2>Up next</h2></div>
        <div class="up-next-module-body"><UpNextList /></div>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        // Album art can only be changed by admins, so only they get the editor.
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
        if (_isAdmin)
        {
            _modules = BuildModules(includeAlbumArt: true);
            AlbumArtEditor.IsAvailable = true;
        }

        try
        {
            _mediaItems = (await ApiClient.GetMediaItemsAsync()).ToList();
            _artists = (await ApiClient.GetArtistsAsync()).OrderBy(a => a.Name).ToList();
            _albums = (await ApiClient.GetAlbumsAsync()).OrderBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading media library: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleItemUpdated(MediaItemDto updated)
    {
        var index = _mediaItems.FindIndex(m => m.Id == updated.Id);
        if (index >= 0)
        {
            _mediaItems[index] = updated;
        }

        // A tag edit can change which artist/album a track belongs to, so
        // refresh the groupings those components derive their lists from.
        try
        {
            _artists = (await ApiClient.GetArtistsAsync()).OrderBy(a => a.Name).ToList();
            _albums = (await ApiClient.GetAlbumsAsync()).OrderBy(a => a.Name).ToList();
        }
        catch
        {
            // The track edit itself already succeeded; leave the stale groupings
            // in place rather than surfacing an error for this best-effort refresh.
        }
    }
}
