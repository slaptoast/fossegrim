@page "/profile"
@attribute [Authorize]
@inject FossegrimApiClient ApiClient
@inject NavigationManager Navigation
@inject AppearanceService Appearance

<div class="container medium">
    <div class="header small">
        <h1>👤 Profile</h1>
        <p>Manage your account settings</p>
    </div>

    <div class="content">
        @if (_statusMessage is not null)
        {
            <div class="success-message">@_statusMessage</div>
        }

        <div class="info-section">
            <h3>Account Information</h3>
            <div class="info-item">
                <span class="info-label">Username:</span>
                <span class="info-value">@_username</span>
            </div>
            <div class="info-item">
                <span class="info-label">Email:</span>
                <span class="info-value">@_email</span>
            </div>
        </div>

        <h3 class="section-header">Update Profile</h3>

        <EditForm Model="_input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="displayName">Display Name</label>
                <InputText id="displayName" @bind-Value="_input.DisplayName" />
                <ValidationMessage For="() => _input.DisplayName" />
            </div>

            <div class="form-group">
                <label for="phoneNumber">Phone Number</label>
                <InputText id="phoneNumber" @bind-Value="_input.PhoneNumber" type="tel" />
                <ValidationMessage For="() => _input.PhoneNumber" />
            </div>

            <button type="submit" class="button">Update Profile</button>
        </EditForm>

        <h3 class="section-header">Playback</h3>

        <div class="form-group">
            <label class="checkbox-row">
                <input type="checkbox" checked="@Appearance.Current.Player.AutoFill" @onchange="SetAutoFillAsync" />
                Keep playing when the queue ends
            </label>
            <p class="backup-hint">Adds another random album if you were playing an album, or more random tracks if you were playing tracks, picked with your preferred random. Queues started from the Random modules always keep going.</p>
        </div>

        <div class="form-group">
            <label for="preferredRandom">Preferred random</label>
            <select id="preferredRandom" value="@Appearance.Current.Random.PreferredMode" @onchange="SetPreferredRandomAsync">
                <option value="@RandomModes.Adjusted">Adjusted: favour what I haven't played recently, or ever</option>
                <option value="@RandomModes.Full">Full: every track equally likely</option>
            </select>
            <p class="backup-hint">Used by the Random albums and Random tracks modules on the Library page, and for the random tracks or albums that follow when you play from them. Each module's own Full / Adjusted switch overrides this.</p>
        </div>

        @if (_lastFm is { Configured: true })
        {
            <h3 class="section-header">Last.fm</h3>

            @if (_lastFmError is not null)
            {
                <div class="error-message">@_lastFmError</div>
            }

            @if (_lastFm.Connected)
            {
                <div class="info-item">
                    <span class="info-label">Linked account:</span>
                    <span class="info-value">@(_lastFm.UserName ?? "Linked")</span>
                </div>
                <button class="button-danger" disabled="@_lastFmBusy" @onclick="UnlinkLastFmAsync">Unlink Last.fm</button>
            }
            else
            {
                <p>Link your Last.fm account to report what you're playing.</p>
                <button class="button-secondary" disabled="@_lastFmBusy" @onclick="ConnectLastFmAsync">Connect Last.fm</button>
            }
        }
    </div>
</div>

@code {
    private string _username = "";
    private string _email = "";
    private readonly ProfileInput _input = new();
    private string? _statusMessage;
    private LastFmStatusDto? _lastFm;
    private string? _lastFmError;
    private bool _lastFmBusy;

    protected override async Task OnInitializedAsync()
    {
        await Appearance.EnsureLoadedAsync();
        var profile = await ApiClient.GetProfileAsync();
        if (profile is not null)
        {
            LoadFrom(profile);
        }

        try
        {
            _lastFm = await ApiClient.GetLastFmStatusAsync();
        }
        catch
        {
            // Leave the Last.fm section hidden if its status can't be loaded.
        }
    }

    private Task SetAutoFillAsync(ChangeEventArgs e) =>
        Appearance.UpdateAsync(p => p.Player.AutoFill = e.Value is true);

    private Task SetPreferredRandomAsync(ChangeEventArgs e) =>
        Appearance.UpdateAsync(p => p.Random.PreferredMode = RandomModes.Sanitize(e.Value?.ToString()));

    // Sends the user to Last.fm, which redirects back to LastFmCallback.razor.
    private async Task ConnectLastFmAsync()
    {
        _lastFmBusy = true;
        _lastFmError = null;
        try
        {
            var url = await ApiClient.GetLastFmAuthUrlAsync(Navigation.ToAbsoluteUri("profile/lastfm").ToString());
            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            _lastFmError = $"Could not start linking Last.fm: {ex.Message}";
            _lastFmBusy = false;
        }
    }

    private async Task UnlinkLastFmAsync()
    {
        _lastFmBusy = true;
        _lastFmError = null;
        try
        {
            _lastFm = await ApiClient.UnlinkLastFmAsync();
        }
        catch (Exception ex)
        {
            _lastFmError = $"Could not unlink Last.fm: {ex.Message}";
        }
        finally
        {
            _lastFmBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        var updated = await ApiClient.UpdateProfileAsync(_input.DisplayName, _input.PhoneNumber);
        LoadFrom(updated);
        _statusMessage = "Your profile has been updated";
    }

    private void LoadFrom(ProfileDto profile)
    {
        _username = profile.UserName;
        _email = profile.Email;
        _input.DisplayName = profile.DisplayName;
        _input.PhoneNumber = profile.PhoneNumber;
    }

    private class ProfileInput
    {
        [StringLength(100, MinimumLength = 3)]
        public string? DisplayName { get; set; }

        [Phone]
        public string? PhoneNumber { get; set; }
    }
}
