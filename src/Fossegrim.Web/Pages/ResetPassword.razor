@page "/reset-password"
@layout LoginLayout
@inject FossegrimApiClient ApiClient
@inject NavigationManager Navigation

<div class="container narrow">
    <div class="header">
        <h1>🔑 Reset Password</h1>
        <p>Choose a new password</p>
    </div>

    <div class="content">
        @if (string.IsNullOrEmpty(User) || string.IsNullOrEmpty(Token))
        {
            <div class="error-message">This link is incomplete. Open the whole link from your email, or ask for a new one.</div>
        }
        else
        {
            @if (_errors.Count > 0)
            {
                <div class="validation-summary">
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <p>Your other devices will be signed out.</p>

            <EditForm Model="_input" OnValidSubmit="ResetAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <InputText id="newPassword" @bind-Value="_input.NewPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _input.NewPassword" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <InputText id="confirmPassword" @bind-Value="_input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _input.ConfirmPassword" />
                </div>

                <button type="submit" class="button" disabled="@_busy">@(_busy ? "Saving..." : "Set new password")</button>
            </EditForm>
        }
    </div>

    <div class="content">
        <div class="nav-links centered">
            <a href="/forgot-password">Need a new link?</a>
            <a href="/login">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? User { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private readonly ResetInput _input = new();
    private List<string> _errors = [];
    private bool _busy;

    private async Task ResetAsync()
    {
        _busy = true;
        _errors = [];
        try
        {
            _errors = (await ApiClient.ResetPasswordAsync(User!, Token!, _input.NewPassword)).ToList();
            if (_errors.Count == 0)
            {
                Navigation.NavigateTo("/login?reset=1", replace: true);
            }
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private class ResetInput
    {
        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
