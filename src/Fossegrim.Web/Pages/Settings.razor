@page "/settings"
@attribute [Authorize(Roles = "Admin")]

<div class="form-stack">
    <FormFrame Glyph="♫" Title="Media Folders" Description="Where Fossegrim reads your music from.">
        <MediaFolderSettings />
    </FormFrame>

    <FormFrame Glyph="✎" Title="File Naming" Description="How Rename files names and files your music.">
        <FileNamingSettings />
    </FormFrame>

    <FormFrame Glyph="♪" Title="Last.fm" Description="Lets people report what they play to their Last.fm account.">
        <LastFmSettings />
    </FormFrame>

    <FormFrame Glyph="☺︎" Title="Accounts" Description="Who can sign in, and adding people by hand.">
        <AccountSettings />
    </FormFrame>

    <FormFrame Glyph="✉︎" Title="Email" Description="Lets people reset a forgotten password themselves.">
        <EmailSettings />
    </FormFrame>

    <FormFrame Glyph="✓" Title="HTTPS" Id="https" Description="Free certificates from Let's Encrypt, renewed automatically.">
        <HttpsSettings />
    </FormFrame>

    <FormFrame Glyph="⇄" Title="API Keys" Description="Let other applications start library scans.">
        <ApiKeySettings />
    </FormFrame>

    <FormFrame Glyph="↺" Title="Backups" Description="The database and its keys, zipped on a schedule.">
        <BackupSettings />
    </FormFrame>
</div>
