@page "/settings"
@attribute [Authorize(Roles = "Admin")]

<div class="container">
    <div class="header">
        <h1>⚙️ Settings</h1>
        <p>Configure your Fossegrim application</p>
    </div>

    <div class="content">
        <h2 class="section-header">Configured Folders</h2>
        <MediaFolderSettings />

        <h2 class="section-header">Last.fm</h2>
        <LastFmSettings />

        <h2 class="section-header">Accounts</h2>
        <AccountSettings />

        <h2 class="section-header">Backups</h2>
        <BackupSettings />
    </div>
</div>
