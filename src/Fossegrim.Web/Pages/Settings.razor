@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@inject FossegrimApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container">
    <div class="header">
        <h1>⚙️ Settings</h1>
        <p>Configure your Fossegrim application</p>
    </div>

    <div class="content">
        <h2 class="section-header">Configured Folders</h2>

        @if (_isLoading)
        {
            <div class="loading"><h2>Loading folders</h2></div>
        }
        else if (_folders.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th class="actions-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var folder in _folders)
                    {
                        <tr>
                            <td class="title-cell">@(string.IsNullOrEmpty(folder.Name) ? "Unnamed" : folder.Name)</td>
                            <td><span class="file-path" title="@folder.Location">@folder.Location</span></td>
                            <td class="actions-cell">
                                <button class="button-secondary" @onclick="() => ScanFolderAsync(folder)">Scan</button>
                                <button class="button-danger" @onclick="() => RemoveFolderAsync(folder)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-results">
                <p>No media folders configured yet. Add one below to get started.</p>
            </div>
        }

        @if (_statusMessage is not null)
        {
            <div class="@(_isSuccess ? "success-message" : "error-message")">@_statusMessage</div>
        }

        <h2 class="section-header">Add Media Folder</h2>

        <EditForm Model="_newFolder" OnValidSubmit="AddFolderAsync">
            <DataAnnotationsValidator />

            <div class="folder-item">
                <div class="form-group">
                    <label for="location">Folder Location</label>
                    <InputText id="location" @bind-Value="_newFolder.Location" placeholder="/Users/username/Music" />
                    <ValidationMessage For="() => _newFolder.Location" />
                </div>

                <div class="form-group">
                    <label for="name">Folder Name</label>
                    <InputText id="name" @bind-Value="_newFolder.Name" placeholder="My Music Collection" />
                    <ValidationMessage For="() => _newFolder.Name" />
                </div>

                <button type="submit" class="button-secondary">+ Add Folder</button>
            </div>
        </EditForm>

        <h2 class="section-header">Last.fm</h2>

        @if (_lastFm is null)
        {
            <div class="loading"><h2>Loading Last.fm settings</h2></div>
        }
        else if (_lastFm.SetByEnvironment)
        {
            <p>Last.fm is configured by the <code>LASTFM_API_KEY</code> and <code>LASTFM_API_SECRET</code> environment variables. Unset them to manage it here.</p>
        }
        else
        {
            <p>
                Lets each user link their own Last.fm account from their Profile.
                Create an API application at
                <a href="https://www.last.fm/api/account/create" target="_blank" rel="noopener">last.fm/api/account/create</a>
                (the callback URL can be left blank) and enter its key and shared secret.
                Changing to a different application unlinks everyone's accounts.
            </p>

            @if (_lastFmMessage is not null)
            {
                <div class="@(_lastFmSuccess ? "success-message" : "error-message")">@_lastFmMessage</div>
            }

            <EditForm Model="_lastFmInput" OnValidSubmit="SaveLastFmAsync">
                <DataAnnotationsValidator />

                <div class="folder-item">
                    <div class="form-group">
                        <label for="lastFmApiKey">API Key</label>
                        <InputText id="lastFmApiKey" @bind-Value="_lastFmInput.ApiKey" autocomplete="off" />
                        <ValidationMessage For="() => _lastFmInput.ApiKey" />
                    </div>

                    <div class="form-group">
                        <label for="lastFmApiSecret">Shared Secret</label>
                        <InputText id="lastFmApiSecret" type="password" @bind-Value="_lastFmInput.ApiSecret" autocomplete="new-password"
                                   placeholder="@(_lastFm.HasSecret ? "Saved; leave blank to keep it" : "")" />
                    </div>

                    <button type="submit" class="button-secondary" disabled="@_lastFmBusy">Save</button>
                    @if (_lastFm.Configured)
                    {
                        <button type="button" class="button-danger" disabled="@_lastFmBusy" @onclick="ClearLastFmAsync">Turn Off Last.fm</button>
                    }
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private List<MediaFolderDto> _folders = [];
    private readonly NewFolderInput _newFolder = new();
    private bool _isLoading = true;
    private string? _statusMessage;
    private bool _isSuccess;

    private LastFmSettingsDto? _lastFm;
    private readonly LastFmSettingsInput _lastFmInput = new();
    private string? _lastFmMessage;
    private bool _lastFmSuccess;
    private bool _lastFmBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadFoldersAsync();
        await LoadLastFmAsync();
    }

    private async Task LoadLastFmAsync()
    {
        try
        {
            SetLastFm(await ApiClient.GetLastFmSettingsAsync());
        }
        catch (Exception ex)
        {
            _lastFmMessage = $"Failed to load Last.fm settings: {ex.Message}";
            _lastFmSuccess = false;
        }
    }

    private async Task SaveLastFmAsync()
    {
        _lastFmBusy = true;
        try
        {
            SetLastFm(await ApiClient.UpdateLastFmSettingsAsync(_lastFmInput.ApiKey, _lastFmInput.ApiSecret));
            _lastFmMessage = "Last.fm settings saved. Users can now link their accounts from their Profile.";
            _lastFmSuccess = true;
        }
        catch (Exception ex)
        {
            _lastFmMessage = ex.Message;
            _lastFmSuccess = false;
        }
        finally
        {
            _lastFmBusy = false;
        }
    }

    private async Task ClearLastFmAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Turn off Last.fm? Users' linked accounts stop updating until it's set up again.");
        if (!confirmed)
        {
            return;
        }

        _lastFmBusy = true;
        try
        {
            SetLastFm(await ApiClient.ClearLastFmSettingsAsync());
            _lastFmMessage = "Last.fm turned off.";
            _lastFmSuccess = true;
        }
        catch (Exception ex)
        {
            _lastFmMessage = $"Failed to turn off Last.fm: {ex.Message}";
            _lastFmSuccess = false;
        }
        finally
        {
            _lastFmBusy = false;
        }
    }

    private void SetLastFm(LastFmSettingsDto settings)
    {
        _lastFm = settings;
        _lastFmInput.ApiKey = settings.ApiKey ?? "";
        _lastFmInput.ApiSecret = null;
    }

    private async Task LoadFoldersAsync()
    {
        _isLoading = true;
        try
        {
            _folders = (await ApiClient.GetMediaFoldersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load media folders: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddFolderAsync()
    {
        var result = await ApiClient.AddMediaFolderAsync(_newFolder.Name, _newFolder.Location);
        if (result.Success)
        {
            _statusMessage = $"Successfully added folder '{result.Folder!.Name}'.";
            _isSuccess = true;
            _newFolder.Name = "";
            _newFolder.Location = "";
            await LoadFoldersAsync();
        }
        else
        {
            _statusMessage = result.ErrorMessage;
            _isSuccess = false;
        }
    }

    private async Task RemoveFolderAsync(MediaFolderDto folder)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove {folder.Name}?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteMediaFolderAsync(folder.Id);
            _statusMessage = "Successfully removed folder.";
            _isSuccess = true;
            await LoadFoldersAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to remove folder: {ex.Message}";
            _isSuccess = false;
        }
    }

    private async Task ScanFolderAsync(MediaFolderDto folder)
    {
        try
        {
            await ApiClient.ScanAsync(folder.Location, maxDegreeOfParallelism: 4);
            _statusMessage = $"Scan of '{folder.Name}' complete.";
            _isSuccess = true;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Scan failed: {ex.Message}";
            _isSuccess = false;
        }
    }

    private class LastFmSettingsInput
    {
        [Required(ErrorMessage = "API key is required.")]
        public string ApiKey { get; set; } = string.Empty;

        public string? ApiSecret { get; set; }
    }

    private class NewFolderInput
    {
        [Required]
        public string Location { get; set; } = string.Empty;

        [Required]
        public string Name { get; set; } = string.Empty;
    }
}
