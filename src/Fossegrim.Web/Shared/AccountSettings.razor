@inject FossegrimApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@using System.IdentityModel.Tokens.Jwt

@* Whether people can sign themselves up, the accounts there are (with reset
   links for forgotten passwords, and deleting), deleted accounts to restore,
   and adding accounts by hand. Used on the Settings page and in the setup
   wizard. *@

@if (_message is not null)
{
    <div class="@(_success ? "success-message" : "error-message")">@_message</div>
}

@if (_status is not null)
{
    <div class="folder-item">
        <label class="checkbox-row">
            <input type="checkbox" checked="@_status.RegistrationOpen" disabled="@_busy" @onchange="SetRegistrationAsync" />
            Allow anyone who can reach this server to create an account
        </label>
        <p class="backup-hint">
            When this is off, the sign-in page has no "Create account" link and only admins can add accounts, using the form below.
        </p>
    </div>
}

@if (_errors.Count > 0)
{
    <div class="validation-summary">
        <ul>
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (_users.Count > 0)
{
    <div class="folder-item">
        <p class="backup-hint">
            Someone forgot their password? Make them a reset link and send it to them. It works once, for 24 hours, and signs them out everywhere.
            @if (_resetByEmail is false)
            {
                <span>Set up email below and they can get one themselves from "Forgot password?" on the sign-in page.</span>
            }
        </p>
        <ul class="account-list">
            @foreach (var user in _users)
            {
                <li>
                    <div class="account-row">
                        <div class="account-who">
                            <strong>@user.DisplayName</strong>
                            @if (user.IsAdmin)
                            {
                                <span class="account-badge">Admin</span>
                            }
                            @if (user.LockedOut)
                            {
                                <span class="account-badge warning" title="Too many wrong passwords; a reset unlocks it">Locked</span>
                            }
                            <div class="backup-hint">@user.Email</div>
                        </div>
                        <div class="account-actions">
                            <button type="button" class="button-secondary" disabled="@_busy" @onclick="() => MakeResetLinkAsync(user)">Reset link</button>
                            @if (user.UserId != _myUserId)
                            {
                                <button type="button" class="button-danger" disabled="@_busy" @onclick="() => _confirmDelete = user">Delete</button>
                            }
                        </div>
                    </div>
                    @if (_resetLink is { } link && link.UserId == user.UserId)
                    {
                        <div class="reset-link">
                            <input type="text" readonly value="@link.Url" aria-label="Reset link for @user.DisplayName" />
                            <button type="button" class="button-secondary" @onclick="CopyLinkAsync">@(_copied ? "Copied" : "Copy")</button>
                        </div>
                        <p class="backup-hint">Valid until @link.ExpiresAt.ToLocalTime().ToString("g"). Making another link for @user.DisplayName replaces this one.</p>
                    }
                </li>
            }
        </ul>
    </div>
}

@if (_deletedUsers.Count > 0)
{
    <div class="folder-item">
        <p class="backup-hint">
            <strong>Deleted accounts.</strong> These can't sign in and don't show up anywhere else. Their playlists, plays and favourites are kept, so restoring one brings it back as it was.
        </p>
        <ul class="account-list">
            @foreach (var user in _deletedUsers)
            {
                <li>
                    <div class="account-row">
                        <div class="account-who">
                            <strong>@user.DisplayName</strong>
                            @if (user.IsAdmin)
                            {
                                <span class="account-badge">Admin</span>
                            }
                            <div class="backup-hint">@user.Email · deleted @user.DeletedAt?.ToLocalTime().ToString("d")</div>
                        </div>
                        <button type="button" class="button-secondary" disabled="@_busy" @onclick="() => RestoreAsync(user)">Restore</button>
                    </div>
                </li>
            }
        </ul>
    </div>
}

<ConfirmDialog IsOpen="_confirmDelete is not null"
               Title="Delete Account"
               Message="@($"Delete {_confirmDelete?.DisplayName}? They're signed out everywhere and can't sign in again. Their playlists, plays and favourites are kept, and you can restore the account under Deleted accounts.")"
               ConfirmText="Delete"
               OnConfirm="DeleteAsync"
               OnCancel="() => _confirmDelete = null" />

<EditForm Model="_input" OnValidSubmit="AddUserAsync">
    <DataAnnotationsValidator />

    <div class="folder-item">
        <div class="backup-grid">
            <div class="form-group">
                <label for="newUserEmail">Email</label>
                <InputText id="newUserEmail" type="email" @bind-Value="_input.Email" autocomplete="off" />
                <ValidationMessage For="() => _input.Email" />
            </div>
            <div class="form-group">
                <label for="newUserName">Username</label>
                <InputText id="newUserName" @bind-Value="_input.DisplayName" autocomplete="off" />
                <ValidationMessage For="() => _input.DisplayName" />
            </div>
            <div class="form-group">
                <label for="newUserPassword">Password</label>
                <InputText id="newUserPassword" type="password" @bind-Value="_input.Password" autocomplete="new-password" />
                <ValidationMessage For="() => _input.Password" />
            </div>
        </div>

        <label class="checkbox-row">
            <InputCheckbox @bind-Value="_input.IsAdmin" />
            Make this person an admin
        </label>

        <button type="submit" class="button-secondary" disabled="@_busy">+ Add Account</button>
    </div>
</EditForm>

@code {
    // Raised after registration is opened or closed, or an account is added.
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private SetupStatusDto? _status;
    private IReadOnlyList<AdminUserDto> _users = [];
    private IReadOnlyList<AdminUserDto> _deletedUsers = [];
    private string? _myUserId;
    private AdminUserDto? _confirmDelete;
    private bool? _resetByEmail;
    private (string UserId, string Url, DateTime ExpiresAt)? _resetLink;
    private bool _copied;
    private NewUserInput _input = new();
    private List<string> _errors = [];
    private string? _message;
    private bool _success;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _myUserId = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value;
            _status = await ApiClient.GetSetupStatusAsync();
            await LoadUsersAsync();
            _resetByEmail = (await ApiClient.GetPasswordResetOptionsAsync()).ByEmail;
        }
        catch (Exception ex)
        {
            (_message, _success) = ($"Failed to load account settings: {ex.Message}", false);
        }
    }

    private async Task SetRegistrationAsync(ChangeEventArgs e)
    {
        _busy = true;
        _message = null;
        try
        {
            _status = await ApiClient.SetRegistrationOpenAsync(e.Value is true);
            (_message, _success) = (_status.RegistrationOpen ? "Anyone can now create an account." : "Only admins can add accounts now.", true);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            (_message, _success) = ($"Failed to save: {ex.Message}", false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddUserAsync()
    {
        _busy = true;
        _message = null;
        _errors = [];
        try
        {
            _errors = (await ApiClient.CreateUserAsync(_input.Email, _input.DisplayName, _input.Password, _input.IsAdmin)).ToList();
            if (_errors.Count == 0)
            {
                (_message, _success) = ($"Added {_input.DisplayName} ({_input.Email}){(_input.IsAdmin ? " as an admin" : "")}.", true);
                _input = new NewUserInput();
                await LoadUsersAsync();
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            (_message, _success) = (ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _users = await ApiClient.GetUsersAsync();
        _deletedUsers = await ApiClient.GetUsersAsync(deleted: true);
    }

    private async Task DeleteAsync()
    {
        if (_confirmDelete is not { } user)
        {
            return;
        }
        _confirmDelete = null;
        await ChangeAccountAsync(() => ApiClient.DeleteUserAsync(user.UserId), $"Deleted {user.DisplayName}. You can restore the account below.");
    }

    private Task RestoreAsync(AdminUserDto user) =>
        ChangeAccountAsync(() => ApiClient.RestoreUserAsync(user.UserId), $"Restored {user.DisplayName}. They can sign in again.");

    private async Task ChangeAccountAsync(Func<Task> change, string done)
    {
        _busy = true;
        _message = null;
        try
        {
            await change();
            (_message, _success) = (done, true);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            (_message, _success) = (ex.Message, false);
        }
        finally
        {
            try
            {
                await LoadUsersAsync();
            }
            catch (Exception)
            {
                // Keep the lists as they were; the message above says what happened.
            }
            // A reset link shown for an account that's just been deleted no longer works.
            if (_resetLink?.UserId is { } linkFor && _users.All(u => u.UserId != linkFor))
            {
                _resetLink = null;
            }
            _busy = false;
        }
    }

    private async Task MakeResetLinkAsync(AdminUserDto user)
    {
        _busy = true;
        _message = null;
        _copied = false;
        try
        {
            var link = await ApiClient.CreatePasswordResetLinkAsync(user.UserId);
            _resetLink = (user.UserId, Navigation.BaseUri.TrimEnd('/') + link.Path, link.ExpiresAt);
        }
        catch (Exception ex)
        {
            (_message, _success) = (ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        if (_resetLink is not { } link)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link.Url);
            _copied = true;
        }
        catch (JSException)
        {
            // No clipboard access (e.g. plain http); the link can still be selected and copied by hand.
            (_message, _success) = ("Couldn't copy automatically; select the link and copy it.", false);
        }
    }

    private class NewUserInput
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [Display(Name = "Username")]
        [StringLength(100, MinimumLength = 3)]
        public string DisplayName { get; set; } = string.Empty;

        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = string.Empty;

        public bool IsAdmin { get; set; }
    }
}
