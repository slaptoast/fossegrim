@inject FossegrimApiClient ApiClient
@inject ToastService Toasts

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Cancel">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Add @MediaItemIds.Count Track@(MediaItemIds.Count == 1 ? "" : "s") to Playlist</h3>
            </div>
            <div class="modal-body">
                @if (_errorMessage is not null)
                {
                    <div class="error">@_errorMessage</div>
                }

                @if (_isLoading)
                {
                    <p>Loading playlists...</p>
                }
                else
                {
                    @if (_playlists.Count == 0)
                    {
                        <p>You don't have any playlists you can edit yet. Create one:</p>
                    }
                    <div class="playlist-picker-list">
                        @foreach (var playlist in _playlists)
                        {
                            <button type="button" class="context-menu-item" disabled="@_isSaving" @onclick="() => AddAsync(playlist)">
                                @playlist.Name
                                <span class="playlist-picker-count">@playlist.TrackCount</span>
                            </button>
                        }
                    </div>

                    <div class="new-playlist-box playlist-picker-new">
                        <input type="text" placeholder="New playlist name..." @bind="_newPlaylistName" @bind:event="oninput"
                               @onkeydown="OnNewPlaylistKeyDownAsync" aria-label="New playlist name" />
                        <button type="button" class="button-secondary" disabled="@(string.IsNullOrWhiteSpace(_newPlaylistName) || _isSaving)"
                                @onclick="CreateAndAddAsync">+ New playlist</button>
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button type="button" class="button-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public IReadOnlyList<Guid> MediaItemIds { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    // Raised with the playlist id after tracks were added, so a page showing
    // that playlist can refresh it.
    [Parameter]
    public EventCallback<Guid> OnAdded { get; set; }

    private List<PlaylistDto> _playlists = [];
    private bool _isLoading;
    private bool _isSaving;
    private bool _wasOpen;
    private string? _errorMessage;
    private string _newPlaylistName = "";

    protected override async Task OnParametersSetAsync()
    {
        // Reload each time the modal opens so newly created or shared playlists show up.
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _newPlaylistName = "";
            await LoadPlaylistsAsync();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task LoadPlaylistsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var playlists = await ApiClient.GetPlaylistsAsync();
            _playlists = playlists
                .Where(p => p.Type == "Standard" && (p.AccessLevel == "Owner" || p.AccessLevel == "Editor"))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading playlists: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddAsync(PlaylistDto playlist)
    {
        if (MediaItemIds.Count == 0)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            await ApiClient.AddPlaylistItemsAsync(playlist.Id, MediaItemIds);
            Toasts.Show(AddedMessage(playlist.Name));
            await OnClose.InvokeAsync();
            await OnAdded.InvokeAsync(playlist.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error adding to \"{playlist.Name}\": {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Creates a playlist and adds the tracks to it in one go.
    private async Task CreateAndAddAsync()
    {
        var name = _newPlaylistName.Trim();
        if (name.Length == 0 || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        PlaylistDto created;
        try
        {
            created = await ApiClient.CreatePlaylistAsync(name);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating \"{name}\": {ex.Message}";
            _isSaving = false;
            return;
        }

        _isSaving = false;
        await AddAsync(created);
    }

    private async Task OnNewPlaylistKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateAndAddAsync();
        }
    }

    private string AddedMessage(string playlistName) => MediaItemIds.Count == 1
        ? $"Added 1 track to \"{playlistName}\""
        : $"Added {MediaItemIds.Count} tracks to \"{playlistName}\"";

    private Task Cancel() => OnClose.InvokeAsync();
}
