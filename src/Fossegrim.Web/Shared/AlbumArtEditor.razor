@implements IAsyncDisposable
@inject AlbumArtEditorState Editor
@inject FossegrimApiClient ApiClient
@inject ToastService Toasts
@inject IJSRuntime JS

@* Changes an album's cover (admins only): search the free cover services or
   upload an image, then save it into every track of the album. Opened from
   the album and track right-click menus; see AlbumArtEditorState. *@
<div class="album-art-editor" @ref="_root">
    <div class="album-art-header">
        <h2>Album art@(Target is null ? null : ": ")<span class="album-art-header-album">@Target?.AlbumName</span></h2>
        @if (Temporary)
        {
            <button type="button" class="button-secondary" @onclick="Editor.Close">Close</button>
        }
    </div>

    @if (Target is null)
    {
        <div class="album-art-empty">Right-click an album or track and choose <strong>Edit album art</strong>.</div>
    }
    else
    {
        <div class="album-art-body">
            <div class="album-art-preview">
                @if (_selection is { } selection)
                {
                    <div class="album-art-frame"><img src="@selection.PreviewUrl" alt="New cover" /></div>
                    <span class="album-art-caption">New cover: @selection.Label</span>
                    <button type="button" class="button" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Saving…" : "Use this cover")</button>
                    <button type="button" class="button-secondary" disabled="@_saving" @onclick="() => _selection = null">Cancel</button>
                    <span class="album-art-note">Saved into every track of this album.</span>
                }
                else
                {
                    <div class="album-art-frame">
                        <span class="album-art-frame-placeholder">💿</span>
                        @if (_currentCoverUrl is not null)
                        {
                            <img src="@_currentCoverUrl" alt="Current cover" onerror="this.style.visibility='hidden'" onload="this.style.visibility=''" />
                        }
                    </div>
                    <span class="album-art-caption">Current cover</span>
                    <button type="button" class="button-secondary" @onclick="ChooseFileAsync">Upload image…</button>
                }
                <input type="file" accept="image/jpeg,image/png" class="album-art-file" @ref="_fileInput" @onchange="OnFileChosenAsync" tabindex="-1" aria-hidden="true" />
            </div>

            <div class="album-art-search">
                <form class="album-art-search-form" @onsubmit="SearchAsync">
                    <input type="text" @bind="_album" placeholder="Album" aria-label="Album" />
                    <input type="text" @bind="_artist" placeholder="Artist" aria-label="Artist" />
                    <button type="submit" class="button" disabled="@(_searching || AllLimited)"
                            title="@(AllLimited ? "Both services are limited; see below" : null)">@(_searching ? "Searching…" : "Search")</button>
                </form>

                <ul class="album-art-providers" aria-live="polite">
                    @foreach (var provider in _providers)
                    {
                        var wait = SecondsLeft(provider);
                        var state = provider.State == "limited" && wait == 0 ? "ready" : provider.State;
                        <li class="album-art-provider is-@state">
                            <span class="album-art-provider-dot" aria-hidden="true"></span>
                            <span>
                                <strong>@provider.Name</strong>
                                @if (state == "ready" && provider.State == "limited")
                                {
                                    <text>Ready again.</text>
                                }
                                else
                                {
                                    @provider.Message
                                }
                                @if (state == "limited")
                                {
                                    <text> Try again in @(wait)s.</text>
                                }
                                else if (state == "unavailable")
                                {
                                    <text> Search again to retry.</text>
                                }
                            </span>
                        </li>
                    }
                </ul>

                @if (_error is not null)
                {
                    <p class="album-art-error" role="alert">@_error</p>
                }

                @if (_results is not null)
                {
                    @foreach (var provider in _providers)
                    {
                        var found = _results.Where(r => r.Provider == provider.Provider).ToList();
                        <section class="album-art-results" aria-label="@provider.Name results">
                            <h3>@provider.Name</h3>
                            @if (found.Count > 0)
                            {
                                <ul class="album-art-result-grid">
                                    @foreach (var result in found)
                                    {
                                        <li>
                                            <button type="button" class="album-art-result @(_selection?.ImageUrl == result.ImageUrl ? "selected" : null)"
                                                    @onclick="() => Select(result)" title="@result.Title">
                                                <img src="@result.PreviewUrl" alt="" loading="lazy" />
                                                <span class="album-art-result-title">@result.Title</span>
                                                <span class="album-art-result-detail">@string.Join(" · ", new[] { result.Artist, result.Year }.Where(s => !string.IsNullOrEmpty(s)))</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (_searchedStates.GetValueOrDefault(provider.Provider) == "ready")
                            {
                                <p class="album-art-none">No covers found.</p>
                            }
                            else
                            {
                                <p class="album-art-none">Didn't search: see @provider.Name's status above.</p>
                            }
                        </section>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    // Uploads are shrunk to this on their longest side before they're sent.
    private const int MaxImageSide = 1200;

    // Shown at the top of the Library until closed, rather than as a module someone placed.
    [Parameter]
    public bool Temporary { get; set; }

    private ElementReference _root;
    private ElementReference _fileInput;
    private IJSObjectReference? _module;
    private AlbumArtTarget? _shown;
    private bool _reveal;
    private string _album = "";
    private string _artist = "";
    private string? _currentCoverUrl;
    private IReadOnlyList<CoverProviderStatusDto> _providers = [];
    private DateTime _providersAt;
    // Each provider's state when the last search ran, to tell "nothing found" from "didn't search".
    private Dictionary<string, string> _searchedStates = [];
    private IReadOnlyList<CoverSearchResultDto>? _results;
    private bool _searching;
    private bool _saving;
    private string? _error;
    private Selection? _selection;
    private CancellationTokenSource? _countdown;
    private bool _disposed;

    // A search result (ImageUrl) or an upload (Upload) waiting to be saved.
    private sealed record Selection(string PreviewUrl, string Label, string? ImageUrl, byte[]? Upload);

    private AlbumArtTarget? Target => Editor.Target;

    private bool AllLimited => _providers.Count > 0 && _providers.All(p => p.State == "limited" && SecondsLeft(p) > 0);

    protected override void OnInitialized()
    {
        Editor.Changed += OnEditorChanged;
        Editor.CoverChanged += OnCoverChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _reveal = Target is not null;
        await SyncTargetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reveal)
        {
            _reveal = false;
            await ModuleAsync(m => m.InvokeVoidAsync("reveal", _root).AsTask());
        }
    }

    private void OnEditorChanged() => InvokeAsync(async () =>
    {
        _reveal = Target is not null; // opened again, maybe from further down the page
        await SyncTargetAsync();
        StateHasChanged();
    });

    private void OnCoverChanged(Guid albumId) => InvokeAsync(async () =>
    {
        if (Target?.AlbumId == albumId)
        {
            await LoadCurrentCoverAsync();
            StateHasChanged();
        }
    });

    // Starts afresh when a different album is opened.
    private async Task SyncTargetAsync()
    {
        if (Target == _shown)
        {
            return;
        }

        _shown = Target;
        _results = null;
        _selection = null;
        _error = null;
        if (Target is null)
        {
            return;
        }

        _album = Target.AlbumName;
        _artist = Target.ArtistName ?? "";
        await LoadCurrentCoverAsync();
        await RefreshProvidersAsync();
    }

    private async Task LoadCurrentCoverAsync()
    {
        if (Target is { } target)
        {
            _currentCoverUrl = await ApiClient.GetAlbumCoverUrl(target.AlbumId) + $"&v={Editor.CoverVersion(target.AlbumId)}";
        }
    }

    private async Task RefreshProvidersAsync()
    {
        try
        {
            SetProviders(await ApiClient.GetCoverProvidersAsync());
        }
        catch (Exception ex)
        {
            _error = $"Couldn't check the cover services: {ex.Message}";
        }
    }

    private void SetProviders(IReadOnlyList<CoverProviderStatusDto> providers)
    {
        _providers = providers;
        _providersAt = DateTime.UtcNow;
        StartCountdown();
    }

    private int SecondsLeft(CoverProviderStatusDto provider) => provider.RetryAfterSeconds is { } seconds
        ? Math.Max(0, (int)Math.Ceiling(seconds - (DateTime.UtcNow - _providersAt).TotalSeconds))
        : 0;

    // Ticks the "Try again in" countdowns, and asks the server again once they run out.
    private void StartCountdown()
    {
        _countdown?.Cancel();
        if (!_providers.Any(p => SecondsLeft(p) > 0))
        {
            return;
        }

        var countdown = _countdown = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                while (_providers.Any(p => SecondsLeft(p) > 0))
                {
                    await Task.Delay(1000, countdown.Token);
                    StateHasChanged();
                }
                if (!_disposed)
                {
                    await RefreshProvidersAsync();
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException)
            {
                // Replaced by a newer status, or disposed.
            }
        });
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_album) || _searching)
        {
            return;
        }

        _searching = true;
        _error = null;
        try
        {
            var response = await ApiClient.SearchCoversAsync(_album.Trim(), _artist.Trim());
            _results = response.Results;
            _searchedStates = response.Providers.ToDictionary(p => p.Provider, p => p.State);
            SetProviders(response.Providers);
        }
        catch (Exception ex)
        {
            _error = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private void Select(CoverSearchResultDto result)
    {
        var label = string.IsNullOrEmpty(result.Artist) ? result.Title : $"{result.Title} by {result.Artist}";
        _selection = new Selection(result.PreviewUrl, label, result.ImageUrl, null);
    }

    private Task ChooseFileAsync() => ModuleAsync(m => m.InvokeVoidAsync("choose", _fileInput).AsTask());

    private async Task OnFileChosenAsync()
    {
        _error = null;
        try
        {
            byte[]? image = null;
            await ModuleAsync(async m => image = await m.InvokeAsync<byte[]?>("prepareImage", _fileInput, MaxImageSide));
            if (image is { Length: > 0 })
            {
                var mimeType = image[0] == 0x89 ? "image/png" : "image/jpeg";
                _selection = new Selection($"data:{mimeType};base64,{Convert.ToBase64String(image)}", "your upload", null, image);
            }
        }
        catch (JSException ex)
        {
            // The first line is the script's message; the rest is its stack.
            _error = ex.Message.Split('\n')[0];
        }
    }

    private async Task SaveAsync()
    {
        if (Target is not { } target || _selection is not { } selection || _saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var result = selection.Upload is { } image
                ? await ApiClient.UploadAlbumCoverAsync(target.AlbumId, image)
                : await ApiClient.SetAlbumCoverFromSearchAsync(target.AlbumId, selection.ImageUrl!);

            if (result.Updated == 0)
            {
                _error = result.Errors.FirstOrDefault()?.Error is { } error
                    ? $"The cover couldn't be saved: {error}"
                    : "This album has no tracks to save the cover into.";
                return;
            }

            var tracks = result.Updated == 1 ? "1 track" : $"{result.Updated} tracks";
            Toasts.Show(result.Errors.Count == 0
                ? $"Saved the cover to {tracks}."
                : $"Saved the cover to {tracks}; {result.Errors.Count} couldn't be updated ({result.Errors[0].Error})");
            _selection = null;
            Editor.NotifyCoverChanged(target.AlbumId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ModuleAsync(Func<IJSObjectReference, Task> call)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/albumArt.js");
        await call(_module);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Editor.Changed -= OnEditorChanged;
        Editor.CoverChanged -= OnCoverChanged;
        _countdown?.Cancel();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; nothing to clean up.
            }
        }
    }
}
