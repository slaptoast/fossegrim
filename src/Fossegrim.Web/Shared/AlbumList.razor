@inject FossegrimApiClient ApiClient
@inject PlayerState PlayerState
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AlbumArtEditorState AlbumArtEditor
@inject ScanStatusService Scans
@inject ToastService Toasts
@implements IDisposable

<div class="album-list-component">
    <div class="album-list-header">
        <h2>Albums</h2>
        <div class="search-box">
            <input type="text" placeholder="🔍 Search albums..." @oninput="OnFilterChanged" />
        </div>
    </div>

    <div class="album-list-container">
        @if (FilteredAlbums.Count > 0)
        {
            <ul class="album-list">
                @foreach (var album in PagedAlbums)
                {
                    <li class="album-item" @oncontextmenu="e => ShowContextMenu(e, album)" @oncontextmenu:preventDefault="true">
                        <div class="album-art" @onclick="() => PlayAlbumAsync(album)">
                            <span class="album-art-placeholder">💿</span>
                            @if (_coverUrls.TryGetValue(album.Id, out var coverUrl))
                            {
                                <img src="@coverUrl" alt="@album.Name" onerror="this.style.visibility='hidden'" onload="this.style.visibility=''" />
                            }
                            <div class="album-play-overlay">▶</div>
                        </div>
                        <div class="album-title">@album.Name</div>
                        <div class="album-artist">@ArtistNames(album)</div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="no-results">
                <p>No albums found.</p>
            </div>
        }
    </div>

    <Pager @bind-CurrentPage="_currentPage" TotalPages="TotalPages" />
</div>

<ContextMenu IsOpen="_contextMenuOpen" X="_contextMenuX" Y="_contextMenuY" Actions="_contextMenuActions" OnClose="CloseContextMenu" />

<AddToPlaylistModal IsOpen="_showAddToPlaylist" MediaItemIds="_addToPlaylistIds" OnClose="() => _showAddToPlaylist = false" />

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired]
    public IReadOnlyList<AlbumDto> Albums { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<MediaItemDto> AllMediaItems { get; set; } = [];

    private readonly Dictionary<Guid, string> _coverUrls = [];
    private string _filter = "";
    private int _currentPage = 1;
    private bool _isAdmin;

    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private IReadOnlyList<ContextMenuAction> _contextMenuActions = [];

    private bool _showAddToPlaylist;
    private IReadOnlyList<Guid> _addToPlaylistIds = [];

    protected override async Task OnInitializedAsync()
    {
        AlbumArtEditor.CoverChanged += OnCoverChanged;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
    }

    private List<AlbumDto> FilteredAlbums =>
        Albums.Where(a => a.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAlbums.Count / (double)PageSize));

    private List<AlbumDto> PagedAlbums =>
        FilteredAlbums.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnParametersSetAsync()
    {
        foreach (var album in Albums)
        {
            if (!_coverUrls.ContainsKey(album.Id))
            {
                _coverUrls[album.Id] = await ApiClient.GetAlbumCoverUrl(album.Id);
            }
        }
    }

    private static string ArtistNames(AlbumDto album) =>
        album.Artists.Any() ? string.Join(", ", album.Artists.Select(a => a.Name)) : "Unknown Artist";

    private void OnFilterChanged(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private List<MediaItemDto> AlbumTracks(AlbumDto album) => AllMediaItems
        .Where(m => m.Albums.Any(a => a.Id == album.Id))
        .OrderBy(m => m.Track ?? int.MaxValue)
        .ThenBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private Task PlayAlbumAsync(AlbumDto album)
    {
        var tracks = AlbumTracks(album);
        return tracks.Count > 0 ? PlayerState.PlayAlbumAsync(album.Id, tracks) : Task.CompletedTask;
    }

    private void ShowContextMenu(MouseEventArgs e, AlbumDto album)
    {
        var trackIds = AlbumTracks(album).Select(m => m.Id).ToList();
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;

        var actions = new List<ContextMenuAction>
        {
            new("Add to next in queue", () => PlayerState.AddToQueueNextAsync(trackIds)),
            new("Add to end of queue", () => PlayerState.AddToQueueEndAsync(trackIds)),
            new("Add to playlist...", () =>
            {
                OpenAddToPlaylist(trackIds);
                return Task.CompletedTask;
            })
        };

        if (_isAdmin)
        {
            actions.Add(new ContextMenuAction("Edit all tags", () =>
            {
                NavigateToEditTags(trackIds);
                return Task.CompletedTask;
            }));
            if (AlbumArtEditor.IsAvailable)
            {
                actions.Add(new ContextMenuAction("Edit album art", () =>
                {
                    AlbumArtEditor.Open(new AlbumArtTarget(album.Id, album.Name, album.Artists.FirstOrDefault()?.Name));
                    return Task.CompletedTask;
                }));
            }
            actions.Add(new ContextMenuAction("Rename files...", () =>
            {
                Navigation.NavigateTo($"/files/rename?ids={Uri.EscapeDataString(string.Join(',', trackIds))}");
                return Task.CompletedTask;
            }));
            actions.Add(new ContextMenuAction("Rescan album", () => RescanAsync(album)));
        }

        _contextMenuActions = actions;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu() => _contextMenuOpen = false;

    private async Task RescanAsync(AlbumDto album)
    {
        try
        {
            await Scans.RescanAlbumAsync(album.Id);
            Toasts.Show($"Rescanning {album.Name}");
        }
        catch (Exception ex)
        {
            Toasts.Show($"Couldn't rescan {album.Name}: {ex.Message}");
        }
    }

    private void OpenAddToPlaylist(IReadOnlyList<Guid> mediaItemIds)
    {
        _addToPlaylistIds = mediaItemIds;
        _showAddToPlaylist = true;
    }

    // A saved cover keeps its URL, so add a version to make the browser load it again.
    private void OnCoverChanged(Guid albumId) => InvokeAsync(async () =>
    {
        _coverUrls[albumId] = await ApiClient.GetAlbumCoverUrl(albumId) + $"&v={AlbumArtEditor.CoverVersion(albumId)}";
        StateHasChanged();
    });

    public void Dispose()
    {
        AlbumArtEditor.CoverChanged -= OnCoverChanged;
    }

    private void NavigateToEditTags(IEnumerable<Guid> trackIds)
    {
        var ids = string.Join(',', trackIds);
        Navigation.NavigateTo($"/tags/edit?ids={Uri.EscapeDataString(ids)}");
    }
}
