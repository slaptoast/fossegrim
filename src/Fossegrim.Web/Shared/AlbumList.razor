@inject FossegrimApiClient ApiClient
@inject PlayerState PlayerState
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AlbumArtEditorState AlbumArtEditor
@inject ScanStatusService Scans
@inject ToastService Toasts
@implements IDisposable

<div class="album-list-component">
    <div class="album-list-header">
        <h2>@Title</h2>
        <BrowseControls @ref="_controls" Sorts="SortOptions" ShowSearch="Query is null" Query="@Query" Placeholder="🔍 Search albums..." Changed="() => LoadAsync(1)" />
    </div>

    <div class="album-list-container">
        @if (_error is not null)
        {
            <div class="error-message">@_error</div>
        }
        else if (_result is { Items.Count: > 0 })
        {
            <ul class="album-list">
                @foreach (var album in _result.Items)
                {
                    <li class="album-item" @oncontextmenu="e => ShowContextMenu(e, album)" @oncontextmenu:preventDefault="true">
                        <div class="album-art" @onclick="() => PlayAlbumAsync(album)">
                            <span class="album-art-placeholder">💿</span>
                            @if (_coverUrls.TryGetValue(album.Id, out var coverUrl))
                            {
                                <img src="@coverUrl" alt="@album.Name" onerror="this.style.visibility='hidden'" onload="this.style.visibility=''" />
                            }
                            <div class="album-play-overlay">▶</div>
                        </div>
                        <div class="album-title">@album.Name</div>
                        <div class="album-artist">@ArtistNames(album)</div>
                    </li>
                }
            </ul>
        }
        else if (_result is not null)
        {
            <div class="no-results">
                <p>No albums found.</p>
            </div>
        }
    </div>

    <Pager CurrentPage="_page" CurrentPageChanged="LoadAsync" TotalPages="_result?.TotalPages ?? 1" />
</div>

<ContextMenu IsOpen="_contextMenuOpen" X="_contextMenuX" Y="_contextMenuY" Actions="_contextMenuActions" OnClose="CloseContextMenu" />

<AddToPlaylistModal IsOpen="_showAddToPlaylist" MediaItemIds="_addToPlaylistIds" OnClose="() => _showAddToPlaylist = false" />

@code {
    private const int PageSize = 10;

    private static readonly IReadOnlyList<(string, string)> SortOptions =
    [
        (LibrarySorts.Name, "Name"),
        (LibrarySorts.Relevance, "Best match"),
        (LibrarySorts.Artist, "Artist"),
        (LibrarySorts.Year, "Year"),
        (LibrarySorts.Added, "Recently added"),
        (LibrarySorts.Played, "Most played"),
        (LibrarySorts.Recent, "Recently played"),
    ];

    [Parameter]
    public string Title { get; set; } = "Albums";

    // Set by the search page: show only albums matching it, without a search box.
    [Parameter]
    public string? Query { get; set; }

    private BrowseControls? _controls;
    private PagedResult<AlbumListItemDto>? _result;
    private string? _error;
    private string? _loadedQuery;
    private int _page = 1;
    private readonly Dictionary<Guid, string> _coverUrls = [];
    private bool _isAdmin;

    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private IReadOnlyList<ContextMenuAction> _contextMenuActions = [];

    private bool _showAddToPlaylist;
    private IReadOnlyList<Guid> _addToPlaylistIds = [];

    protected override async Task OnInitializedAsync()
    {
        AlbumArtEditor.CoverChanged += OnCoverChanged;
        Scans.ScanFinished += OnScanFinished;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
    }

    // First load, and again whenever the search page's query changes.
    protected override async Task OnParametersSetAsync()
    {
        if (_result is null || _loadedQuery != Query)
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int page)
    {
        _loadedQuery = Query;
        var query = _controls?.Current(page, PageSize) ?? new BrowseQuery(Page: page, PageSize: PageSize);
        // The controls only get a new Query after this component has loaded.
        if (Query is not null)
        {
            query = query with { Q = Query };
        }

        try
        {
            _result = await ApiClient.GetAlbumsAsync(query);
            _page = page;
            _error = null;
            foreach (var album in _result.Items.Where(a => !_coverUrls.ContainsKey(a.Id)))
            {
                _coverUrls[album.Id] = await ApiClient.GetAlbumCoverUrl(album.Id);
            }
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load albums: {ex.Message}";
        }
    }

    // Shows the current page again, e.g. after a tag edit elsewhere on the page.
    public async Task ReloadAsync()
    {
        await LoadAsync(_page);
        StateHasChanged();
    }

    // A scan (e.g. a right-click rescan) can add, change or remove albums.
    private void OnScanFinished(ScanJobDto job) => InvokeAsync(async () =>
    {
        await LoadAsync(_page);
        StateHasChanged();
    });

    private static string ArtistNames(AlbumListItemDto album) =>
        album.Artists.Any() ? string.Join(", ", album.Artists.Select(a => a.Name)) : "Unknown Artist";

    private async Task PlayAlbumAsync(AlbumListItemDto album)
    {
        var tracks = await ApiClient.GetAlbumTracksAsync(album.Id);
        if (tracks.Count > 0)
        {
            await PlayerState.PlayAlbumAsync(album.Id, tracks);
        }
    }

    private async Task<IReadOnlyList<Guid>> TrackIdsAsync(AlbumListItemDto album) =>
        (await ApiClient.GetAlbumTracksAsync(album.Id)).Select(t => t.Id).ToList();

    private void ShowContextMenu(MouseEventArgs e, AlbumListItemDto album)
    {
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;

        var actions = new List<ContextMenuAction>
        {
            new("Add to next in queue", async () => await PlayerState.AddToQueueNextAsync(await TrackIdsAsync(album))),
            new("Add to end of queue", async () => await PlayerState.AddToQueueEndAsync(await TrackIdsAsync(album))),
            new("Add to playlist...", async () => OpenAddToPlaylist(await TrackIdsAsync(album))),
        };

        if (_isAdmin)
        {
            actions.Add(new ContextMenuAction("Edit all tags", async () =>
                Navigation.NavigateTo($"/tags/edit?ids={Uri.EscapeDataString(string.Join(',', await TrackIdsAsync(album)))}")));
            if (AlbumArtEditor.IsAvailable)
            {
                actions.Add(new ContextMenuAction("Edit album art", () =>
                {
                    AlbumArtEditor.Open(new AlbumArtTarget(album.Id, album.Name, album.Artists.FirstOrDefault()?.Name));
                    return Task.CompletedTask;
                }));
            }
            actions.Add(new ContextMenuAction("Rename files...", async () =>
                Navigation.NavigateTo($"/files/rename?ids={Uri.EscapeDataString(string.Join(',', await TrackIdsAsync(album)))}")));
            actions.Add(new ContextMenuAction("Rescan album", () => RescanAsync(album)));
        }

        _contextMenuActions = actions;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu() => _contextMenuOpen = false;

    private async Task RescanAsync(AlbumListItemDto album)
    {
        try
        {
            await Scans.RescanAlbumAsync(album.Id);
            Toasts.Show($"Rescanning {album.Name}");
        }
        catch (Exception ex)
        {
            Toasts.Show($"Couldn't rescan {album.Name}: {ex.Message}");
        }
    }

    private void OpenAddToPlaylist(IReadOnlyList<Guid> mediaItemIds)
    {
        _addToPlaylistIds = mediaItemIds;
        _showAddToPlaylist = true;
    }

    // A saved cover keeps its URL, so add a version to make the browser load it again.
    private void OnCoverChanged(Guid albumId) => InvokeAsync(async () =>
    {
        _coverUrls[albumId] = await ApiClient.GetAlbumCoverUrl(albumId) + $"&v={AlbumArtEditor.CoverVersion(albumId)}";
        StateHasChanged();
    });

    public void Dispose()
    {
        AlbumArtEditor.CoverChanged -= OnCoverChanged;
        Scans.ScanFinished -= OnScanFinished;
    }
}
