@inject FossegrimApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider

@if (_displayVersion is not null)
{
    <footer class="app-footer">
        @if (_update is { UpdateAvailable: true })
        {
            <a href="/admin" class="update-badge" title="A newer release is on Docker Hub">Update available: v@(_update.LatestVersion)</a>
        }
        @_displayVersion
    </footer>
}

@code {
    private string? _displayVersion;
    private UpdateStatusDto? _update;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var version = await ApiClient.GetVersionAsync();
            if (!string.IsNullOrEmpty(version))
            {
                // Real releases are bare semver ("1.2.3") and read best with a
                // "v" prefix; anything else (e.g. "dev" for an untagged local
                // build, or a PR/sha fallback from CI) already reads fine as-is
                // -- "vdev" does not.
                _displayVersion = char.IsDigit(version[0]) ? $"v{version}" : version;
            }

            // Only admins can act on an update, so only they see the badge.
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.IsInRole("Admin"))
            {
                _update = await ApiClient.GetUpdateStatusAsync();
            }
        }
        catch
        {
            // Version display is informational only -- never block the page on it.
        }
    }
}
