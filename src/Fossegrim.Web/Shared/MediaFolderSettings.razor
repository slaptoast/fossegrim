@inject FossegrimApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject ScanStatusService Scans

@* The library's media folders: list, add, remove and scan. Used on the
   Settings page and in the setup wizard. *@

@if (_isLoading)
{
    <div class="loading"><h2>Loading folders</h2></div>
}
else if (_folders.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th class="actions-cell">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var folder in _folders)
            {
                <tr>
                    <td class="title-cell">@(string.IsNullOrEmpty(folder.Name) ? "Unnamed" : folder.Name)</td>
                    <td><span class="file-path" title="@folder.Location">@folder.Location</span></td>
                    <td class="actions-cell">
                        <button class="button-secondary" title="Read new and changed files" @onclick="() => ScanFolderAsync(folder, full: false)">Scan</button>
                        <button class="button-secondary" title="Re-read every file" @onclick="() => ScanFolderAsync(folder, full: true)">Full Rescan</button>
                        <button class="button-danger" @onclick="() => RemoveFolderAsync(folder)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <ScanProgress />
}
else
{
    <div class="no-results">
        <p>No media folders configured yet. Add one below to get started.</p>
    </div>
}

@if (_statusMessage is not null)
{
    <div class="@(_isSuccess ? "success-message" : "error-message")">@_statusMessage</div>
}

<h2 class="section-header">Add Media Folder</h2>

<EditForm Model="_newFolder" OnValidSubmit="AddFolderAsync">
    <DataAnnotationsValidator />

    <div class="folder-item">
        <div class="form-group">
            <label for="location">Folder Location</label>
            <InputText id="location" @bind-Value="_newFolder.Location" placeholder="/Users/username/Music" />
            <ValidationMessage For="() => _newFolder.Location" />
        </div>

        <div class="form-group">
            <label for="name">Folder Name</label>
            <InputText id="name" @bind-Value="_newFolder.Name" placeholder="My Music Collection" />
            <ValidationMessage For="() => _newFolder.Name" />
        </div>

        <button type="submit" class="button-secondary">+ Add Folder</button>
    </div>
</EditForm>

@code {
    // Raised after a folder is added, removed or scanned.
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<MediaFolderDto> _folders = [];
    private readonly NewFolderInput _newFolder = new();
    private bool _isLoading = true;
    private string? _statusMessage;
    private bool _isSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadFoldersAsync();
    }

    private async Task LoadFoldersAsync()
    {
        _isLoading = true;
        try
        {
            _folders = (await ApiClient.GetMediaFoldersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load media folders: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddFolderAsync()
    {
        var result = await ApiClient.AddMediaFolderAsync(_newFolder.Name, _newFolder.Location);
        if (result.Success)
        {
            _statusMessage = $"Successfully added folder '{result.Folder!.Name}'.";
            _isSuccess = true;
            _newFolder.Name = "";
            _newFolder.Location = "";
            await LoadFoldersAsync();
            await OnChanged.InvokeAsync();
        }
        else
        {
            _statusMessage = result.ErrorMessage;
            _isSuccess = false;
        }
    }

    private async Task RemoveFolderAsync(MediaFolderDto folder)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove {folder.Name}?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteMediaFolderAsync(folder.Id);
            _statusMessage = "Successfully removed folder.";
            _isSuccess = true;
            await LoadFoldersAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to remove folder: {ex.Message}";
            _isSuccess = false;
        }
    }

    // Queues the scan; its progress shows in ScanProgress below the table.
    private async Task ScanFolderAsync(MediaFolderDto folder, bool full)
    {
        _statusMessage = null;
        try
        {
            await Scans.StartAsync(new StartScanRequest(FolderIds: [folder.Id], Full: full));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Couldn't start the scan: {ex.Message}";
            _isSuccess = false;
        }
    }

    private class NewFolderInput
    {
        [Required]
        public string Location { get; set; } = string.Empty;

        [Required]
        public string Name { get; set; } = string.Empty;
    }
}
