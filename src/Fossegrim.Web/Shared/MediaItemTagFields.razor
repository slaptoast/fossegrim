@if (Compact)
{
    <td class="tag-edit-file" title="@FullPath">
        <div>@(Model.FileName ?? "—")</div>
        @if (Model.Folder is not null)
        {
            <div class="tag-edit-folder">@Model.Folder/</div>
        }
    </td>
    <td><input type="text" @bind="Model.Title" @bind:event="oninput" placeholder="Title" /></td>
    <td><input type="text" @bind="Model.ArtistName" @bind:event="oninput" placeholder="Artist" /></td>
    <td><input type="text" @bind="Model.Album" @bind:event="oninput" placeholder="Album" /></td>
    <td><input type="number" @bind="Model.Track" @bind:event="oninput" /></td>
    <td><input type="number" @bind="Model.Year" @bind:event="oninput" /></td>
    <td><input type="text" @bind="Model.Genre" @bind:event="oninput" placeholder="Genre" /></td>
}
else
{
    <div class="form tag-fields">
        <div class="form-grid">
            @if (!string.IsNullOrEmpty(Model.FileName))
            {
                <div class="form-group">
                    <span class="form-label">File</span>
                    <div class="tag-edit-file" title="@FullPath">
                        @if (Model.Folder is not null)
                        {
                            <span class="tag-edit-folder">@Model.Folder/</span>
                        }
                        @Model.FileName
                    </div>
                </div>
            }
            <div class="form-group">
                <label for="@(_id)-title">Title</label>
                <input id="@(_id)-title" type="text" @bind="Model.Title" @bind:event="oninput" />
            </div>
            <div class="form-group span-3">
                <label for="@(_id)-artist">Artist</label>
                <input id="@(_id)-artist" type="text" @bind="Model.ArtistName" @bind:event="oninput" />
            </div>
            <div class="form-group span-3">
                <label for="@(_id)-album">Album</label>
                <input id="@(_id)-album" type="text" @bind="Model.Album" @bind:event="oninput" />
            </div>
            <div class="form-group span-1">
                <label for="@(_id)-track">Track</label>
                <input id="@(_id)-track" type="number" @bind="Model.Track" @bind:event="oninput" />
            </div>
            <div class="form-group span-1">
                <label for="@(_id)-year">Year</label>
                <input id="@(_id)-year" type="number" @bind="Model.Year" @bind:event="oninput" />
            </div>
            <div class="form-group span-4">
                <label for="@(_id)-genre">Genre</label>
                <input id="@(_id)-genre" type="text" @bind="Model.Genre" @bind:event="oninput" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public MediaItemTagEditModel Model { get; set; } = null!;

    // Compact renders bare <td> cells for use inside a caller-provided <tr>
    // (the multi-track edit page); the default renders a labeled vertical
    // form (the single-track edit modal).
    [Parameter]
    public bool Compact { get; set; }

    // Ties each label to its field; unique per instance.
    private readonly string _id = "tag-" + Guid.NewGuid().ToString("N")[..8];

    // Hover text: the whole path inside the media folder, in case it's cut off.
    private string? FullPath => Model.Folder is null ? Model.FileName : $"{Model.Folder}/{Model.FileName}";
}
