@implements IDisposable
@inject PlayerState PlayerState
@inject PlayerHost Host

@* The floating player, at the bottom (or top) of every page. It steps aside
   while the Library page's Player panel is on screen, and comes back on
   other pages; playback carries on either way (see PlayerEngine). *@
@if (PlayerState.CurrentTrack is not null && !Host.PanelShown)
{
    <div class="player-bar">
        <PlayerControls />
    </div>
}

@code {
    protected override void OnInitialized()
    {
        PlayerState.Changed += OnChanged;
        Host.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PlayerState.Changed -= OnChanged;
        Host.Changed -= OnChanged;
    }
}
