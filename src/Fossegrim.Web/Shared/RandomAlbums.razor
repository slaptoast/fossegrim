@inject FossegrimApiClient ApiClient
@inject PlayerState PlayerState
@inject AppearanceService Appearance

@* A few random albums for the front page: click the cover to play one
   (another random album follows when it ends), right-click to queue it. *@
<div class="album-list-component random-module">
    <div class="album-list-header">
        <h2>Random albums</h2>
        <RandomModeToggle Mode="_mode" ModeChanged="SetModeAsync" OnReroll="LoadAsync" Loading="_loading" />
    </div>

    <div class="album-list-container">
        @if (_error is not null)
        {
            <div class="no-results"><p>@_error</p></div>
        }
        else if (_albums.Count > 0)
        {
            <ul class="album-list">
                @foreach (var album in _albums)
                {
                    <li class="album-item" @key="album.Id" @oncontextmenu="e => ShowContextMenu(e, album)" @oncontextmenu:preventDefault="true">
                        <div class="album-art" @onclick="() => PlayAlbumAsync(album)" title="Play album">
                            <span class="album-art-placeholder">💿</span>
                            @if (_coverUrls.TryGetValue(album.Id, out var coverUrl))
                            {
                                <img src="@coverUrl" alt="@album.Name" onerror="this.style.visibility='hidden'" onload="this.style.visibility=''" />
                            }
                            <div class="album-play-overlay">▶</div>
                        </div>
                        <div class="album-title">@album.Name</div>
                        <div class="album-artist">@ArtistNames(album)</div>
                    </li>
                }
            </ul>
        }
        else if (!_loading)
        {
            <div class="no-results"><p>No albums yet.</p></div>
        }
    </div>
</div>

<ContextMenu IsOpen="_contextMenuOpen" X="_contextMenuX" Y="_contextMenuY" Actions="_contextMenuActions" OnClose="() => _contextMenuOpen = false" />

<AddToPlaylistModal IsOpen="_showAddToPlaylist" MediaItemIds="_addToPlaylistIds" OnClose="() => _showAddToPlaylist = false" />

@code {
    private const int Count = 5;

    // Album DTOs only list their tracks' ids, so playing one needs the full tracks.
    [Parameter, EditorRequired]
    public IReadOnlyList<MediaItemDto> AllMediaItems { get; set; } = [];

    private IReadOnlyList<AlbumDto> _albums = [];
    private readonly Dictionary<Guid, string> _coverUrls = [];
    private string _mode = RandomModes.Adjusted;
    private bool _loading = true;
    private string? _error;

    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private IReadOnlyList<ContextMenuAction> _contextMenuActions = [];

    private bool _showAddToPlaylist;
    private IReadOnlyList<Guid> _addToPlaylistIds = [];

    protected override async Task OnInitializedAsync()
    {
        await Appearance.EnsureLoadedAsync();
        _mode = Appearance.Current.Random.AlbumModeOrPreferred;
        await LoadAsync();
    }

    private async Task SetModeAsync(string mode)
    {
        _mode = mode;
        // Back on the preferred mode, follow it again if that setting changes.
        await Appearance.UpdateAsync(p => p.Random.AlbumMode = mode == p.Random.PreferredMode ? null : mode);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _albums = await ApiClient.GetRandomAlbumsAsync(_mode, Count);
            foreach (var album in _albums.Where(a => !_coverUrls.ContainsKey(a.Id)))
            {
                _coverUrls[album.Id] = await ApiClient.GetAlbumCoverUrl(album.Id);
            }
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load random albums: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ArtistNames(AlbumDto album) =>
        album.Artists.Any() ? string.Join(", ", album.Artists.Select(a => a.Name)) : "Unknown Artist";

    private List<MediaItemDto> AlbumTracks(AlbumDto album) => AllMediaItems
        .Where(m => m.Albums.Any(a => a.Id == album.Id))
        .OrderBy(m => m.Track ?? int.MaxValue)
        .ThenBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private Task PlayAlbumAsync(AlbumDto album)
    {
        var tracks = AlbumTracks(album);
        return tracks.Count > 0 ? PlayerState.PlayRandomAlbumAsync(album.Id, tracks, _mode) : Task.CompletedTask;
    }

    private void ShowContextMenu(MouseEventArgs e, AlbumDto album)
    {
        var trackIds = AlbumTracks(album).Select(m => m.Id).ToList();
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuActions =
        [
            new("Play album", () => PlayAlbumAsync(album)),
            new("Add to next in queue", () => PlayerState.AddToQueueNextAsync(trackIds)),
            new("Add to end of queue", () => PlayerState.AddToQueueEndAsync(trackIds)),
            new("Add to playlist...", () =>
            {
                _addToPlaylistIds = trackIds;
                _showAddToPlaylist = true;
                return Task.CompletedTask;
            }),
        ];
        _contextMenuOpen = true;
    }
}
