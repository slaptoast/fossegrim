@inject IJSRuntime JS

@* Shown while custom CSS is off for this tab (a page opened with ?safe-mode;
   see js/theme.js), so it's clear why the theme looks plain and how to get
   it back. *@
@if (_safeMode)
{
    <div class="safe-mode-banner" role="status">
        Custom CSS is off in this tab (safe mode).
        <a href="/appearance">Edit your themes</a>
        <button type="button" class="link-button" @onclick="LeaveAsync">Turn it back on</button>
    </div>
}

@code {
    private bool _safeMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _safeMode = await JS.InvokeAsync<bool>("fossegrimTheme.isSafeMode");
            if (_safeMode)
            {
                StateHasChanged();
            }
        }
    }

    private async Task LeaveAsync()
    {
        await JS.InvokeVoidAsync("fossegrimTheme.leaveSafeMode");
        _safeMode = false;
    }
}
