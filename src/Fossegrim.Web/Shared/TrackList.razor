@inject NavigationManager Navigation
@inject PlayerState PlayerState
@inject AuthenticationStateProvider AuthStateProvider
@inject AlbumArtEditorState AlbumArtEditor
@inject FossegrimApiClient ApiClient
@inject ScanStatusService Scans
@inject FavoritesService Favorites
@implements IDisposable

@* Shows either MediaItems (searched, sorted and paged here, e.g. the
   playlist editor's picker) or, with FromServer, the whole library a page
   at a time from the Api. *@
<div class="track-list-component">
    @if (FromServer)
    {
        <div class="controls">
            @if (Title is not null)
            {
                <h2>@Title</h2>
            }
            <BrowseControls @ref="_controls" Sorts="ServerSorts" ShowSearch="Query is null" Query="@Query" FavoritesOnly="FavoritesOnly"
                            Placeholder="🔍 Search by title, artist, or album..." Changed="() => LoadAsync(1)" />
        </div>
    }
    else
    {
        <div class="controls">
            <div class="search-box">
                <input type="text" placeholder="🔍 Search by title, artist, or album..." @oninput="OnSearchChanged" />
            </div>
            <div class="filter-group">
                <label for="sortBy">Sort by:</label>
                <select id="sortBy" @onchange="OnSortChanged">
                    <option value="title">Title</option>
                    <option value="artist">Artist</option>
                    <option value="album">Album</option>
                </select>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="error-message">@_error</div>
    }

    @if (Editable && SelectedIds.Count > 0)
    {
        <div class="track-list-selection-bar">
            <span>@SelectedIds.Count selected</span>
            <button type="button" class="button-secondary" @onclick="ClearSelection">Clear selection</button>
        </div>
    }

    <div class="content">
        @if (FromServer && _result is null)
        {
            @* Still loading the first page. *@
        }
        else if (PagedItems.Count == 0)
        {
            <div class="no-results">
                <h2>No tracks found</h2>
                <p>@(Searching ? "No tracks match your search." : "There are no tracks to show.")</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        @if (Editable)
                        {
                            <th class="select-cell"></th>
                        }
                        @if (FromServer)
                        {
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Album</th>
                        }
                        else
                        {
                            <th @onclick='() => SetSort("title")'>Title</th>
                            <th @onclick='() => SetSort("artist")'>Artist</th>
                            <th @onclick='() => SetSort("album")'>Album</th>
                        }
                        <th class="favorite-cell"><span class="visually-hidden">Favourite</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PagedItems)
                    {
                        <tr @onclick="() => PlayAsync(item)"
                            @oncontextmenu="e => ShowContextMenu(e, item)" @oncontextmenu:preventDefault="true">
                            @if (Editable)
                            {
                                <td class="select-cell" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@IsSelected(item.Id)" @onchange="e => ToggleSelected(item.Id, e)" />
                                </td>
                            }
                            <td class="title-cell">@(item.Title ?? "Unknown")</td>
                            <td class="artist-cell">@(item.ArtistName ?? "Unknown Artist")</td>
                            <td class="album-cell">@(item.Album ?? "Unknown Album")</td>
                            <td class="favorite-cell"><FavoriteButton Kind="@FavoriteKinds.Tracks" Id="item.Id" Name="@(item.Title ?? "this track")" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pager CurrentPage="_currentPage" CurrentPageChanged="GoToPageAsync" TotalPages="TotalPages" />
        }
    </div>
</div>

<ContextMenu IsOpen="_contextMenuOpen" X="_contextMenuX" Y="_contextMenuY" Actions="_contextMenuActions" OnClose="CloseContextMenu" />

<AddToPlaylistModal IsOpen="_showAddToPlaylist" MediaItemIds="_addToPlaylistIds" OnClose="() => _showAddToPlaylist = false" OnAdded="OnAddedToPlaylist" />

<EditTagsModal IsOpen="_showEditModal" Model="_editingModel" OnSaved="OnTagsSavedAsync" OnCancel="() => _showEditModal = false" />

@code {
    private const int PageSize = 25;

    private static readonly IReadOnlyList<(string, string)> ServerSorts =
    [
        (LibrarySorts.Title, "Title"),
        (LibrarySorts.Relevance, "Best match"),
        (LibrarySorts.Artist, "Artist"),
        (LibrarySorts.Album, "Album"),
        (LibrarySorts.Year, "Year"),
        (LibrarySorts.Added, "Recently added"),
        (LibrarySorts.Played, "Most played"),
        (LibrarySorts.Recent, "Recently played"),
        (LibrarySorts.Favorited, "Recently favourited"),
    ];

    // The tracks to show, when not FromServer.
    [Parameter]
    public IReadOnlyList<MediaItemDto> MediaItems { get; set; } = [];

    // Load the library from the Api a page at a time instead of showing MediaItems.
    [Parameter]
    public bool FromServer { get; set; }

    // With FromServer, set by the search page: only tracks matching it, without a search box.
    [Parameter]
    public string? Query { get; set; }

    [Parameter]
    public string? Title { get; set; }

    // With FromServer: only the user's favourite tracks (the Favourites module).
    [Parameter]
    public bool FavoritesOnly { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public IReadOnlyList<Guid> SelectedIds { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<Guid>> SelectedIdsChanged { get; set; }

    [Parameter]
    public EventCallback<MediaItemDto> OnItemUpdated { get; set; }

    // Raised with the playlist id after the user adds tracks to it via the context menu.
    [Parameter]
    public EventCallback<Guid> OnAddedToPlaylist { get; set; }

    private string _searchFilter = "";
    private string _sortBy = "title";
    private int _currentPage = 1;
    private bool _isAdmin;

    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private IReadOnlyList<ContextMenuAction> _contextMenuActions = [];

    private bool _showAddToPlaylist;
    private IReadOnlyList<Guid> _addToPlaylistIds = [];

    private bool _showEditModal;
    private MediaItemTagEditModel? _editingModel;

    private BrowseControls? _controls;
    private PagedResult<MediaItemDto>? _result;
    private string? _loadedQuery;
    private BrowseQuery? _lastQuery;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (FromServer)
        {
            Scans.ScanFinished += OnScanFinished;
            Favorites.Changed += OnFavoritesChanged;
        }
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
    }

    // With FromServer: the first load, and again whenever the search page's query changes.
    protected override async Task OnParametersSetAsync()
    {
        if (FromServer && (_result is null || _loadedQuery != Query))
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int page)
    {
        _loadedQuery = Query;
        var query = _controls?.Current(page, PageSize) ?? new BrowseQuery(Page: page, PageSize: PageSize);
        // The controls only get a new Query after this component has loaded.
        if (Query is not null)
        {
            query = query with { Q = Query };
        }
        if (FavoritesOnly)
        {
            query = query with { Favorites = true };
        }
        _lastQuery = query;

        try
        {
            _result = await ApiClient.GetTracksAsync(query);
            _currentPage = page;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load tracks: {ex.Message}";
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (FromServer)
        {
            await LoadAsync(page);
        }
        else
        {
            _currentPage = page;
        }
    }

    // A heart changed: a list of favourites (or sorted by them) shows a different page.
    private void OnFavoritesChanged(string kind)
    {
        if (kind == FavoriteKinds.Tracks && _lastQuery is { } last && (last.Favorites || last.Sort == LibrarySorts.Favorited))
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync(_currentPage);
                StateHasChanged();
            });
        }
    }

    // A scan can add, change or remove tracks.
    private void OnScanFinished(ScanJobDto job) => InvokeAsync(async () =>
    {
        await LoadAsync(_currentPage);
        StateHasChanged();
    });

    private bool Searching => FromServer
        ? !string.IsNullOrWhiteSpace(Query ?? _controls?.Current(1, PageSize).Q)
        : !string.IsNullOrWhiteSpace(_searchFilter);

    private List<MediaItemDto> VisibleItems => MediaItems
        .Where(m => Matches(m, _searchFilter))
        .OrderBy(m => _sortBy switch
        {
            "artist" => m.ArtistName,
            "album" => m.Album,
            _ => m.Title
        }, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private int TotalPages => FromServer
        ? Math.Max(1, _result?.TotalPages ?? 1)
        : Math.Max(1, (int)Math.Ceiling(VisibleItems.Count / (double)PageSize));

    private IReadOnlyList<MediaItemDto> PagedItems => FromServer
        ? _result?.Items ?? []
        : VisibleItems.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private static bool Matches(MediaItemDto item, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        return (item.Title?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.ArtistName?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Album?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchFilter = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        _sortBy = e.Value?.ToString() ?? "title";
        _currentPage = 1;
    }

    private void SetSort(string sortBy)
    {
        _sortBy = sortBy;
        _currentPage = 1;
    }

    private Task PlayAsync(MediaItemDto item) => PlayerState.PlayAsync(item);

    private bool IsSelected(Guid id) => SelectedIds.Contains(id);

    private Task ToggleSelected(Guid id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        var newSelection = SelectedIds.ToList();

        if (isChecked)
        {
            if (!newSelection.Contains(id))
            {
                newSelection.Add(id);
            }
        }
        else
        {
            newSelection.Remove(id);
        }

        return SelectedIdsChanged.InvokeAsync(newSelection);
    }

    private Task ClearSelection() => SelectedIdsChanged.InvokeAsync(Array.Empty<Guid>());

    private void ShowContextMenu(MouseEventArgs e, MediaItemDto item)
    {
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;

        var actions = new List<ContextMenuAction>
        {
            new("Add to next in queue", () => PlayerState.AddToQueueNextAsync([item.Id])),
            new("Add to end of queue", () => PlayerState.AddToQueueEndAsync([item.Id])),
            Favorites.IsFavorite(FavoriteKinds.Tracks, item.Id)
                ? new ContextMenuAction("Remove from favourites", () => Favorites.SetAsync(FavoriteKinds.Tracks, item.Id, false))
                : new ContextMenuAction("Add to favourites", () => Favorites.SetAsync(FavoriteKinds.Tracks, item.Id, true)),
            new("Add to playlist...", () =>
            {
                OpenAddToPlaylist([item.Id]);
                return Task.CompletedTask;
            })
        };

        if (_isAdmin)
        {
            actions.Add(new ContextMenuAction("Edit tags", () =>
            {
                OpenEditModal(item);
                return Task.CompletedTask;
            }));
            if (AlbumArtEditor.IsAvailable && item.Albums.FirstOrDefault() is { } album)
            {
                actions.Add(new ContextMenuAction("Edit album art", () =>
                {
                    AlbumArtEditor.Open(new AlbumArtTarget(album.Id, album.Name, item.ArtistName));
                    return Task.CompletedTask;
                }));
            }
            actions.Add(new ContextMenuAction("Rename file...", () =>
            {
                Navigation.NavigateTo($"/files/rename?ids={item.Id}");
                return Task.CompletedTask;
            }));
        }

        _contextMenuActions = actions;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu() => _contextMenuOpen = false;

    private void OpenAddToPlaylist(IReadOnlyList<Guid> mediaItemIds)
    {
        _addToPlaylistIds = mediaItemIds;
        _showAddToPlaylist = true;
    }

    private void OpenEditModal(MediaItemDto item)
    {
        _editingModel = MediaItemTagEditModel.FromMediaItem(item);
        _showEditModal = true;
    }

    private async Task OnTagsSavedAsync(MediaItemDto updated)
    {
        _showEditModal = false;
        if (FromServer)
        {
            // The edit may move it in the sort order, or out of the search.
            await LoadAsync(_currentPage);
        }
        await OnItemUpdated.InvokeAsync(updated);
    }

    public void Dispose()
    {
        if (FromServer)
        {
            Scans.ScanFinished -= OnScanFinished;
            Favorites.Changed -= OnFavoritesChanged;
        }
    }
}
