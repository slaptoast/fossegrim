@page
@model Fossegrim.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    ViewData["BodyClass"] = "centered";
}

<div class="container medium">
    <div class="header error large">
        <h1>🚫</h1>
        <h2>Access Denied</h2>
    </div>

    <div class="content centered">
        <p>You do not have permission to access this page.</p>
        <p>If you believe you should have access, please contact the administrator or try logging in with an account that has the required permissions.</p>
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = true })
</div>
