@page
@model Fossegrim.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["BodyClass"] = "centered";
}

<div class="container narrow">
    <div class="header small">
        <h1>🔑 Change Password</h1>
        <p>Update your account password</p>
    </div>

    <div class="content">
        @if (Model.StatusMessage != null)
        {
            <div class="success-message">
                @Model.StatusMessage
            </div>
        }

        <div asp-validation-summary="All" class="validation-summary"></div>

        <form method="post">
            <div class="form-group">
                <label asp-for="Input.OldPassword">Current Password</label>
                <input asp-for="Input.OldPassword" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.NewPassword">New Password</label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="button">Change Password</button>
        </form>
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = true })
</div>
