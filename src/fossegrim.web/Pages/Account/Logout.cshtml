@page
@model Fossegrim.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logout";
    ViewData["BodyClass"] = "centered";
}

<div class="container narrow">
    <div class="header small">
        <h1>👋 Logout</h1>
        <p>Come back soon!</p>
    </div>

    <div class="content centered">
        <p>Are you sure you want to log out?</p>

        <form method="post">
            <button type="submit" class="button">Logout</button>
        </form>
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = true })
</div>
