@page
@model Fossegrim.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container medium">
    <div class="header small">
        <h1>👤 Profile</h1>
        <p>Manage your account settings</p>
    </div>

    <div class="content">
        @if (Model.StatusMessage != null)
        {
            <div class="success-message">
                @Model.StatusMessage
            </div>
        }

        <div class="info-section">
            <h3>Account Information</h3>
            <div class="info-item">
                <span class="info-label">Username:</span>
                <span class="info-value">@Model.Username</span>
            </div>
            <div class="info-item">
                <span class="info-label">Email:</span>
                <span class="info-value">@Model.Email</span>
            </div>
        </div>

        <h3 style="margin-bottom: 20px; color: #495057;">Update Profile</h3>

        <form method="post">
            <div class="form-group">
                <label asp-for="Input.DisplayName">Display Name</label>
                <input asp-for="Input.DisplayName" type="text" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Phone Number</label>
                <input asp-for="Input.PhoneNumber" type="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="button">Update Profile</button>
        </form>
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = false })
</div>
