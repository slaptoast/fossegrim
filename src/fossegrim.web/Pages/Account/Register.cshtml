@page
@model Fossegrim.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "centered";
}

<div class="container narrow">
    <div class="header small">
        <h1>📝 Register</h1>
        <p>Create a new Fossegrim account</p>
    </div>

    <div class="content">
        <div class="info-text">
            Password must be at least 6 characters and include uppercase, lowercase, and a digit.
        </div>

        <div asp-validation-summary="All" class="validation-summary"></div>

        <form method="post">
            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.DisplayName">Display Name</label>
                <input asp-for="Input.DisplayName" type="text" required />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="button">Register</button>
        </form>
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = true })
</div>
