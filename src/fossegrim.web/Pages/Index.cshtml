@page
@model Fossegrim.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "centered";
}

@section Styles {
    <meta http-equiv="refresh" content="3; url=/MediaLibrary" />
}

<div class="container medium">
    <div class="header small">
        <h1>🎵 Welcome to Fossegrim</h1>
        <p>Your personal media library manager</p>
    </div>

    <div class="content">
        <div class="redirect-card">
            <div class="icon">🎶</div>
            <h2>Redirecting to Media Library...</h2>
            <p>You will be automatically redirected in a few seconds.</p>
        </div>

        <div class="quick-links">
            <a href="/MediaLibrary" class="quick-link">
                <span class="link-icon">🎵</span>
                <span class="link-label">Media Library</span>
            </a>
            <a href="/Settings/Admin" class="quick-link">
                <span class="link-icon">⚙️</span>
                <span class="link-label">Admin Panel</span>
            </a>
            <a href="/Settings/Settings" class="quick-link">
                <span class="link-icon">🔧</span>
                <span class="link-label">Settings</span>
            </a>
            <a href="/Account/Profile" class="quick-link">
                <span class="link-icon">👤</span>
                <span class="link-label">Profile</span>
            </a>
        </div>
    </div>
</div>
