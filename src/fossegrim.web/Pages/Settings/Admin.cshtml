@page
@model Fossegrim.Web.Pages.Settings.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="container">
    <div class="header">
        <h1>⚙️ Admin Panel</h1>
        <p>Manage your media library</p>
    </div>

    <div class="content">
        <form method="post" asp-page-handler="Scan">
            <div class="form-group">
                <label for="FolderPath">Media Folder Path</label>
                <input type="text"
                       id="FolderPath"
                       name="FolderPath"
                       asp-for="FolderPath"
                       placeholder="/Users/username/Music"
                       required />
            </div>

            <div class="form-group">
                <label for="MaxDegreeOfParallelism">Max Parallel Threads</label>
                <input type="number"
                       id="MaxDegreeOfParallelism"
                       name="MaxDegreeOfParallelism"
                       asp-for="MaxDegreeOfParallelism"
                       min="1"
                       max="16"
                       value="4"
                       required />
            </div>

            <button type="submit" class="button" disabled="@Model.IsScanning">
                @(Model.IsScanning ? "Scanning..." : "Scan Media Library")
            </button>
        </form>

        @if (Model.IsScanning)
        {
            <div class="scanning">
                <h2>Scanning media library</h2>
            </div>
        }

        @if (Model.ErrorMessage != null)
        {
            <div class="error">
                <strong>Error</strong>
                @Model.ErrorMessage
            </div>
        }

        @if (Model.LastScanResult != null)
        {
            <div class="result-card">
                <div class="success-icon">✅</div>
                <h2>Scan Complete!</h2>

                <div class="stats-grid">
                    <div class="stat">
                        <div class="stat-value">@Model.LastScanResult.ScannedCount</div>
                        <div class="stat-label">Files Scanned</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">@Model.LastScanResult.ItemsAdded</div>
                        <div class="stat-label">Items Added</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">@Model.LastScanResult.ItemsUpdated</div>
                        <div class="stat-label">Items Updated</div>
                    </div>
                </div>

                <p style="margin-top: 20px; color: #6c757d; font-size: 0.9rem;">
                    <strong>Folder:</strong> @Model.LastScanResult.FolderPath
                </p>
            </div>
        }
    </div>

    @await Component.InvokeAsync("NavLinks", new { centered = false })
</div>
