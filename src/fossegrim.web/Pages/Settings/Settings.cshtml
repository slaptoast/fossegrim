@page
@model Fossegrim.Web.Pages.Settings.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="container">
    <div class="header">
        <h1>⚙️ Settings</h1>
        <p>Configure your Fossegrim application</p>
    </div>

    <div class="content">
        <h2 class="section-header" style="margin-top: 40px;">Configured Folders</h2>

        @if (Model.Input.Folders != null && Model.Input.Folders.Any())
        {
            <table id="foldersTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th style="width: 100px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var folder in Model.Input.Folders)
                    {
                        <tr>
                            <td class="title-cell">@(string.IsNullOrEmpty(folder.Name) ? "Unnamed" : folder.Name)</td>
                            <td><span class="file-path" title="@folder.Location">@folder.Location</span></td>
                            <td style="text-align: center;">
                                <form method="post" asp-page-handler="ScanFolder" asp-route-id="@folder.Id" style="display: inline; margin-right: 8px;">
                                    <button type="submit" class="button-secondary" style="padding: 6px 12px; font-size: 0.85rem;">Scan</button>
                                </form>
                                <form method="post" asp-page-handler="RemoveFolder" asp-route-id="@folder.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to remove @folder.Name?');">
                                    <button type="submit" class="button-danger" style="padding: 6px 12px; font-size: 0.85rem;">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-results">
                <p style="color: #6c757d; font-style: italic;">No media folders configured yet. Add one above to get started.</p>
            </div>
        }





        @if (Model.StatusMessage != null)
        {
            if (Model.IsSuccess)
            {
                <div class="success-message">
                    @Model.StatusMessage
                </div>
            }
            else
            {
                <div class="error-message">
                    @Model.StatusMessage
                </div>
            }
        }

        

        <h2 class="section-header">Add Media Folder</h2>

        <form method="post" asp-page-handler="AddFolder">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="All" class="validation-summary"></div>
            }

            <div class="folder-item">
                <div class="form-group">
                    <label asp-for="NewFolder.Location">Folder Location</label>
                    <input asp-for="NewFolder.Location" type="text" placeholder="/Users/username/Music" required />
                    <span asp-validation-for="NewFolder.Location" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewFolder.Name">Folder Name</label>
                    <input asp-for="NewFolder.Name" type="text" placeholder="My Music Collection" required />
                    <span asp-validation-for="NewFolder.Name" class="text-danger"></span>
                </div>

                <button type="submit" class="button-secondary">+ Add Folder</button>
            </div>
        </form>
    </div>
</div>
