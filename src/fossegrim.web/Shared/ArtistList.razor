<div class="artist-list-component">
    <div class="artist-list-header">
        <h2>Artists</h2>
        <div class="search-box">
            <input type="text" placeholder="🔍 Search artists..." @oninput="OnFilterChanged" />
        </div>
    </div>

    <div class="artist-list-stats">
        <span class="stat">@Artists.Count artist@(Artists.Count != 1 ? "s" : "")</span>
        <span class="stat">@TotalTracks total tracks</span>
    </div>

    <div class="artist-list-container">
        @if (FilteredArtists.Count > 0)
        {
            <ul class="artist-list">
                @foreach (var artist in PagedArtists)
                {
                    var trackCount = artist.MediaItems.Count();
                    <li class="artist-item">
                        <div class="artist-info">
                            <div class="artist-avatar">@artist.Name.Substring(0, 1).ToUpperInvariant()</div>
                            <div class="artist-details">
                                <div class="artist-name">@artist.Name</div>
                                <div class="artist-track-count">@trackCount track@(trackCount != 1 ? "s" : "")</div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
            <Pager @bind-CurrentPage="_currentPage" TotalPages="TotalPages" />
        }
        else
        {
            <div class="no-results">
                <p>No artists found.</p>
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired]
    public IReadOnlyList<ArtistDto> Artists { get; set; } = [];

    private string _filter = "";
    private int _currentPage = 1;

    private int TotalTracks => Artists.Sum(a => a.MediaItems.Count());

    private List<ArtistDto> FilteredArtists =>
        Artists.Where(a => a.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredArtists.Count / (double)PageSize));

    private List<ArtistDto> PagedArtists =>
        FilteredArtists.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private void OnFilterChanged(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }
}
