@implements IAsyncDisposable
@inject PlayerState PlayerState
@inject IJSRuntime JSRuntime

@if (PlayerState.CurrentTrack is not null)
{
    <div class="player-bar">
        <div class="player-track-info">
            <span class="player-title">@(PlayerState.CurrentTrack.Title ?? "Unknown")</span>
            <span class="player-artist">@(PlayerState.CurrentTrack.ArtistName ?? "Unknown Artist")</span>
        </div>

        @if (PlayerState.ErrorMessage is not null)
        {
            <span class="player-error">@PlayerState.ErrorMessage</span>
        }
        else if (PlayerState.StreamUrl is not null)
        {
            <canvas @ref="_visualizerCanvas" class="player-visualizer" aria-hidden="true"></canvas>
            @* crossorigin lets the visualizer read samples when the API is on another origin (local dev);
               without it Web Audio would see a tainted source and output silence. *@
            <audio @ref="_audio" controls autoplay="@PlayerState.AutoPlay" preload="metadata" crossorigin="anonymous" src="@PlayerState.StreamUrl" class="player-audio" @onended="OnTrackEnded">
                Your browser does not support the audio element.
            </audio>
        }
    </div>
}

@code {
    private ElementReference _audio;
    private ElementReference _visualizerCanvas;
    private IJSObjectReference? _visualizer;

    protected override void OnInitialized()
    {
        PlayerState.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PlayerState.StreamUrl is null || PlayerState.ErrorMessage is not null)
        {
            return;
        }

        try
        {
            _visualizer ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/visualizer.js");
            // Idempotent on the JS side; re-run each render in case Blazor swapped the <audio> element.
            await _visualizer.InvokeVoidAsync("attach", _audio, _visualizerCanvas);
        }
        catch (JSException)
        {
            // The visualizer is decoration - never let it break playback.
        }
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private Task OnTrackEnded() => PlayerState.PlayNextAsync();

    public async ValueTask DisposeAsync()
    {
        PlayerState.Changed -= OnChanged;

        if (_visualizer is not null)
        {
            try
            {
                await _visualizer.InvokeVoidAsync("detach", _audio);
                await _visualizer.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
