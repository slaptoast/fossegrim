@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="visualizer-overlay" @ref="_host" role="dialog" aria-label="Visualizer">
    <canvas @ref="_canvas" class="visualizer-canvas" aria-hidden="true"></canvas>

    <div class="visualizer-controls">
        <span class="visualizer-preset" @ref="_presetLabel"></span>
        @if (_isRunning)
        {
            <button type="button" class="visualizer-button" title="Previous preset (←)" @onclick='() => CallAsync("previous")'>‹ Prev</button>
            <button type="button" class="visualizer-button" title="Next preset (→)" @onclick='() => CallAsync("next")'>Next ›</button>
            <button type="button" class="visualizer-button" aria-pressed="@(_isCycling ? "true" : "false")" title="Change preset every 20 seconds" @onclick="ToggleCycleAsync">Auto-cycle</button>
            <button type="button" class="visualizer-button" title="Fullscreen (F)" @onclick='() => CallAsync("toggleFullscreen")'>Fullscreen</button>
        }
        <button type="button" class="visualizer-button" title="Close (Esc)" @onclick="RequestClose">Close</button>
    </div>

    @if (_message is not null)
    {
        <div class="visualizer-message">
            <p>@_message</p>
            @if (_offerShowAnyway)
            {
                <button type="button" class="button" @onclick="ShowAnywayAsync">Show anyway</button>
            }
        </div>
    }
</div>

@code {
    /// <summary>The player bar's &lt;audio&gt; element the visualizer listens to.</summary>
    [Parameter, EditorRequired]
    public ElementReference Audio { get; set; }

    /// <summary>Current track title, shown with MilkDrop's title animation when it changes.</summary>
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _host;
    private ElementReference _canvas;
    private ElementReference _presetLabel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VisualizerOverlay>? _selfReference;
    private bool _isRunning;
    private bool _isCycling = true;
    private bool _offerShowAnyway;
    private string? _message;
    private string? _shownTitle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await OpenAsync(force: false);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isRunning && Title != _shownTitle)
        {
            _shownTitle = Title;
            await CallAsync("showTitle", Title);
        }
    }

    private async Task OpenAsync(bool force)
    {
        try
        {
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/visualizer.js");
            _selfReference ??= DotNetObjectReference.Create(this);
            var result = await _module.InvokeAsync<string>("open", Audio, _host, _canvas, _presetLabel, _selfReference, force);

            _isRunning = result == "ok";
            _offerShowAnyway = result == "reduced-motion";
            _message = result switch
            {
                "ok" => null,
                "reduced-motion" => "Your system is set to reduce motion. This visualizer moves quickly and can flash brightly.",
                "unsupported" => "This browser can't run the visualizer. It needs WebGL 2 and the Web Audio API.",
                _ => "The visualizer couldn't load. Check your connection and try again."
            };
            _shownTitle = Title;
        }
        catch (JSException)
        {
            _isRunning = false;
            _offerShowAnyway = false;
            _message = "The visualizer stopped because of an error in the browser.";
        }

        StateHasChanged();
    }

    private Task ShowAnywayAsync() => OpenAsync(force: true);

    private async Task ToggleCycleAsync()
    {
        if (_module is not null)
        {
            _isCycling = await _module.InvokeAsync<bool>("toggleCycle");
        }
    }

    private async Task CallAsync(string identifier, params object?[] args)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSException)
        {
            // Decoration only -- a failed preset change must never affect playback.
        }
    }

    [JSInvokable]
    public Task RequestClose() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("close");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
